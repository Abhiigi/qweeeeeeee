                                                                                end-if;
                                                                                // end change ABEHERA Bug: 1300175
                                                                                //end change bug: 1317256"
                                                                                //end-if;
                                                                           end-if;
                                                                           //7/10
                                                                      end-for;
                                                                      //lowc logic apply
