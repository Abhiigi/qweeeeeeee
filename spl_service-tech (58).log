                                                                                     move "$fromSaPremiseAddress" to $inputString;
                                                                                     invokeGroovy 'convertToTitleCase';
                                                                                     move "$outputString" to $fromSaPremiseAddress;
                                                                                     move null to "C1-PremiseBasic";
                                                                                     move null to "F1-GetCountryStates";
                                                                                else
                                                                                     move 'N/A' to $fromSaPremiseAddress;
                                                                                end-if;
                                                                                //if("string($todoCreateFlg)= 'Y'")
                                                                                //Current user name
                                                                                move "$USER" to "C1-UserLite/user";
                                                                                invokeBO 'C1-UserLite' using "C1-UserLite" for read;
                                                                                move "concat(C1-UserLite/lastName,', ',C1-UserLite/firstName)" to $userName;
                                                                                //Create To Do
                                                                                move null to "F1-AddToDoEntry";
                                                                                move "$noPaToDoType" to "F1-AddToDoEntry/toDoType";
                                                                                // if ("string($noPaToDoRole) != $BLANK")
                                                                                // move "$noPaToDoRole" to "F1-AddToDoEntry/toDoRole";
                                                                                //end-if;
                                                                                move 'F1_DFLT' to "F1-AddToDoEntry/toDoRole";
                                                                                move '90007' to "F1-AddToDoEntry/messageCategory";
                                                                                move '674' to "F1-AddToDoEntry/messageNumber";
                                                                                move 'SNDR' to "F1-AddToDoEntry/sendTo";
                                                                                move '050' to "F1-AddToDoEntry/priority";
                                                                                move 'O' to "F1-AddToDoEntry/entryStatus";
