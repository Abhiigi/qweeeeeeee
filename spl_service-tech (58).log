                                                       //ADO 1202930 changes end
                                                       goto 30;
                                                  end-if;
                                             end-if;
                                             move "C1-StopServiceRequest/customElements/servicesToStop/stopDate" to $stopDate;
                                             //max date(< 3 days) for lowc (7 days updated to 3 days)
                                             move null to "F1-DateMath";
                                             move "$PROCESS-DATE" to "F1-DateMath/beginDate";
                                             move 'F1AD' to "F1-DateMath/option";
                                             move "xs:integer(3)" to "F1-DateMath/days";
                                             // move "$parmCalendarCode" to "F1-DateMath/calendar";
                                             invokeBS 'F1-DateMath' using "F1-DateMath";
                                             move "F1-DateMath/endDate" to $maxDate;
                                             move "C1-StopServiceRequest/customElements/servicesToStop/cmLocwNdLL/locwEnabled" to $locwEnabled;
                                             move "C1-StopServiceRequest/customElements/servicesToStop/cmLocwNdLL/additionlaFld" to $additionlaFld;
                                             //****
                                             //terminate with error (90003, 1 %1="string($additionlaFld)");
                                             move "C1-StopServiceRequest/customElements/servicesToStop/cmPropertyInfo/isSelling" to $isSelling;
                                             move "C1-StopServiceRequest/customElements/servicesToStop/cmPropertyInfo/newOwnerName" to $newOwnerName;
                                             //terminate with error (90003, 1 %1="string($startServiceChk)");
                                             if ("string($locwEnabled) = 'true'")
                                                  if ("xs:date($stopDate) >= xs:date($PROCESS-DATE)")
                                                       if ("xs:date($stopDate) < xs:date($maxDate)")
                                                            if ("string($startServiceChk) = 'N'")
                                                                 if ("string($isResAcct) = 'Y'")
                                                                      //ADO: 1315569 related chnages. start
                                                                      //  if("string($isSelling) = 'true' and string($newOwnerName) != $BLANK")
                                                                      //ADO: 1315569 related chnages. end
                                                                      //Lowc logic start
                                                                      move null to "C1GetChldCSR";
                                                                      move "$customerServiceRequestId" to "C1GetChldCSR/input/customerServiceRequestId";
                                                                      move 'C1-CSREQSA' to "C1GetChldCSR/input/mo";
                                                                      invokeSS 'C1GetChldCSR' using "C1GetChldCSR";
                                                                      //Check if has SAs
                                                                      if ("count(C1GetChldCSR/output/custSvcReqSA) = 0")
                                                                           terminate;
                                                                      end-if;
                                                                      for ($csReqSA in "C1GetChldCSR/output/custSvcReqSA")
                                                                           // CSREQSA variables
                                                                           move "$csReqSA/custSvcReqSAId" to $csReqSAId;
                                                                           move "$csReqSA/bo" to $csReqSABO;
                                                                           //BO READ to get SA ID
                                                                           declareBO "$csReqSABO" as 'csrSABO_schema';
                                                                           move "$csReqSABO" to "csrSABO_schema/bo";
                                                                           move "$csReqSAId" to "csrSABO_schema/custSvcReqSAId";
                                                                           invokeBO "$csReqSABO" using "csrSABO_schema" for read;
                                                                           move "csrSABO_schema/saId" to $saId;
                                                                           //
                                                                           move "csrSABO_schema/saType" to "C1-SATypeBasic/saType";
                                                                           move "csrSABO_schema/division" to "C1-SATypeBasic/division";
                                                                           invokeBO 'C1-SATypeBasic' using "C1-SATypeBasic" for read;
                                                                           move "C1-SATypeBasic/serviceType" to $serviceType;
                                                                           move "C1-SATypeBasic/revenueClass" to $revenueClass;
                                                                           if ("string($serviceType = 'E')")
                                                                                move 'Electric' to $serviceTypeDesc;
                                                                           end-if;
                                                                           if ("string($serviceType = 'G')")
                                                                                move 'Gas' to $serviceTypeDesc;
                                                                           end-if;
                                                                           if ("string($serviceType = 'M')")
                                                                                move 'Miscellaneous' to $serviceTypeDesc;
                                                                           end-if;
                                                                           if ("string($serviceType) = 'E' or string($serviceType) = 'G'")
                                                                                if ("csrSABO_schema/division = 'MECIA'")
                                                                                     move "$busNameMECIA" to $busAcctName;
                                                                                     invokeGroovy 'srchBusinessAcct';
                                                                                end-if;
                                                                                if ("csrSABO_schema/division = 'MECIL'")
                                                                                     move "$busNameMECIL" to $busAcctName;
                                                                                     invokeGroovy 'srchBusinessAcct';
                                                                                end-if;
                                                                                if ("csrSABO_schema/division = 'MECSD'")
                                                                                     move "$busNameMECSD" to $busAcctName;
                                                                                     invokeGroovy 'srchBusinessAcct';
                                                                                end-if;
                                                                                if ("csrSABO_schema/division = 'MECNE'")
                                                                                     move "$busNameMECNE" to $busAcctName;
                                                                                     invokeGroovy 'srchBusinessAcct';
                                                                                end-if;
                                                                                //create SA on Business account
                                                                                //move null to "CM-ServiceAgreement";
                                                                                //move "string($busAcctId)" to "CM-ServiceAgreement/accountId";
                                                                                //move "csrSABO_schema/division" to "CM-ServiceAgreement/division";
                                                                                //move "csrSABO_schema/saType" to "CM-ServiceAgreement/saType";
                                                                                //move '10' to "CM-ServiceAgreement/status";
                                                                                //move "csrSABO_schema/endDate" to "CM-ServiceAgreement/startDate";
                                                                                //move "string($busPremId)" to "CM-ServiceAgreement/premiseId";
                                                                                // invokeBO 'CM-ServiceAgreement' using "CM-ServiceAgreement" for add;
                                                                                //create SA on Business account end
                                                                                //ADO 1230646 create SA on Business account newLogic start
                                                                                //READ SOURCE SA
                                                                                move 'C1ServiceAgreementPhysical' to $oldSABO;
                                                                                declareBO "$oldSABO" as 'OldSA';
                                                                                move "string(csrSABO_schema/saId)" to "OldSA/serviceAgreement";
                                                                                invokeBO 'C1ServiceAgreementPhysical' using "OldSA" for read;
                                                                                //BUILD NEW SA
                                                                                move 'C1ServiceAgreementPhysical' to $newSABO;
                                                                                declareBO "$newSABO" as 'NewSA';
                                                                                move "$busAcctId" to "NewSA/accountId";
                                                                                move "OldSA/division" to "NewSA/division";
                                                                                move "OldSA/saType" to "NewSA/saType";
                                                                                move "csrSABO_schema/endDate" to "NewSA/startDate";
                                                                                move '10' to "NewSA/status";
                                                                                move "OldSA/customerRead" to "NewSA/customerRead";
                                                                                move "OldSA/currency" to "NewSA/currency";
                                                                                move "OldSA/areEstimatesAllowed" to "NewSA/areEstimatesAllowed";
                                                                                move "OldSA/startOption" to "NewSA/startOption";
                                                                                move "string(OldSA/premiseId)" to "NewSA/premiseId";
                                                                                move "string(OldSA/ibSACutoffTime)" to "NewSA/ibSACutoffTime";
                                                                                move "string(OldSA/startDayOption)" to "NewSA/startDayOption";
                                                                                //COPY ONLY CURRENT/LATEST RATE SCHEDULE FROM OLD SA
                                                                                move "OldSA/serviceAgreementRateScheduleHistory[last()]/rateSchedule" to "NewSA/+serviceAgreementRateScheduleHistory/rateSchedule";
                                                                                move "csrSABO_schema/endDate" to "NewSA/serviceAgreementRateScheduleHistory[last()]/effectiveDate";
                                                                                //COPY SA CHARACTERISTICS
                                                                                if ("count(OldSA/serviceAgreementCharacteristic) > 0")
                                                                                     for ($char in "OldSA/serviceAgreementCharacteristic")
                                                                                          move "$char/characteristicType" to "NewSA/+serviceAgreementCharacteristic/characteristicType";
                                                                                          move "csrSABO_schema/endDate" to "NewSA/serviceAgreementCharacteristic[last()]/effectiveDate";
                                                                                          move "$char/characteristicValue" to "NewSA/serviceAgreementCharacteristic[last()]/characteristicValue";
                                                                                          move "$char/adhocCharacteristicValue" to "NewSA/serviceAgreementCharacteristic[last()]/adhocCharacteristicValue";
                                                                                          move "$char/characteristicValueForeignKey1" to "NewSA/serviceAgreementCharacteristic[last()]/characteristicValueForeignKey1";
                                                                                          move "$char/characteristicValueFK2" to "NewSA/serviceAgreementCharacteristic[last()]/characteristicValueFK2";
                                                                                          move "$char/characteristicValueFK3" to "NewSA/serviceAgreementCharacteristic[last()]/characteristicValueFK3";
                                                                                          move "$char/characteristicValueFk4" to "NewSA/serviceAgreementCharacteristic[last()]/characteristicValueFk4";
                                                                                          move "$char/characteristicValueFK5" to "NewSA/serviceAgreementCharacteristic[last()]/characteristicValueFK5";
                                                                                          move "$char/searchCharacteristicValue" to "NewSA/serviceAgreementCharacteristic[last()]/searchCharacteristicValue";
                                                                                     end-for;
                                                                                end-if;
                                                                                //COPY SA/SP (MULTIPLE SASPs)
                                                                                for ($sp in "OldSA/serviceAgreementServicePoint")
                                                                                     move "$sp/servicePointId" to "NewSA/+serviceAgreementServicePoint/servicePointId";
                                                                                     move "concat(csrSABO_schema/endDate, '-00.00.00')" to "NewSA/serviceAgreementServicePoint[last()]/startDateTime";
                                                                                     //  move "$sp/stopDateTime" to "NewSA/serviceAgreementServicePoint[last()]/stopDateTime";
                                                                                     //need to check this end
                                                                                     move "$sp/howToUseRead" to "NewSA/serviceAgreementServicePoint[last()]/howToUseRead";
                                                                                     move "$sp/usePercent" to "NewSA/serviceAgreementServicePoint[last()]/usePercent";
                                                                                     //COPY SA/SP CHARACTERISTICS
                                                                                     for ($spChar in "$sp/serviceAgreementSpCharacteristic")
                                                                                          move "$spChar/characteristicType" to "NewSA/serviceAgreementServicePoint[last()]/+serviceAgreementSpCharacteristic/characteristicType";
                                                                                          move "$spChar/effectiveDate" to "NewSA/serviceAgreementServicePoint[last()]/serviceAgreementSpCharacteristic[last()]/effectiveDate";
                                                                                          move "$spChar/characteristicValue" to "NewSA/serviceAgreementServicePoint[last()]/serviceAgreementSpCharacteristic[last()]/characteristicValue";
                                                                                          move "$spChar/adhocCharacteristicValue" to "NewSA/serviceAgreementServicePoint[last()]/serviceAgreementSpCharacteristic[last()]/adhocCharacteristicValue";
                                                                                     end-for;
                                                                                end-for;
                                                                                //CREATE NEW SA
                                                                                invokeBO 'C1ServiceAgreementPhysical' using "NewSA" for add;
                                                                                //STORE NEW SA ID
                                                                                move "NewSA/serviceAgreement" to $newSAId;
                                                                                // Activate the New Service Agreement:Defect 1302766 By:P64547
                                                                                move null to "C1-SAActivation";
                                                                                move "$newSAId" to "C1-SAActivation/saId";
                                                                                move 'true' to "C1-SAActivation/activate";
                                                                                invokeBS 'C1-SAActivation' using "C1-SAActivation";
                                                                                //ADO 1230646  create SA on Business account newLogic end
                                                                                //7/10 move "csrSABO_schema/saType" to "C1-SATypeBasic/saType";
                                                                                //7/10 move "csrSABO_schema/division" to "C1-SATypeBasic/division";
                                                                                //7/10 invokeBO 'C1-SATypeBasic' using "C1-SATypeBasic" for read;
                                                                                //7/10 move "C1-SATypeBasic/serviceType" to $serviceType;
                                                                                //7/10 move "C1-SATypeBasic/revenueClass" to $revenueClass;
                                                                                //7/10 if("string($serviceType = 'E')")
                                                                                //7/10  move 'Electric' to $serviceTypeDesc;
                                                                                //7/10 end-if;
                                                                                //7/10 if("string($serviceType = 'G')")
                                                                                //7/10 move 'Gas' to $serviceTypeDesc;
                                                                                //7/10 end-if;
                                                                                //7/10 if("string($serviceType = 'M')")
                                                                                //7/10 move 'Miscellaneous' to $serviceTypeDesc;
                                                                                //7/10 end-if;
                                                                                //move 'Y' to $todoCreateFlg;
                                                                                //Fetch Premise Address
                                                                                if ("string(C1-StopServiceRequest/premiseId) != $BLANK")
                                                                                     move null to "C1-PremiseBasic";
                                                                                     move "C1-StopServiceRequest/premiseId" to "C1-PremiseBasic/premiseId";
                                                                                     invokeBO 'C1-PremiseBasic' using "C1-PremiseBasic" for read;
