                                                                                     move "normalize-space(concat($fromSaPremiseAddress, ', ', C1-PremiseBasic/city))" to $fromSaPremiseAddress;
                                                                                     if ("string(C1-PremiseBasic/state) != $BLANK")
                                                                                          move "normalize-space(concat($fromSaPremiseAddress, ', ', F1-GetCountryStates/states[state=$currentState]/description))" to $fromSaPremiseAddress;
                                                                                     end-if;
                                                                                     move "$fromSaPremiseAddress" to $inputString;
                                                                                     invokeGroovy 'convertToTitleCase';
                                                                                     move "$outputString" to $fromSaPremiseAddress;
                                                                                     move null to "C1-PremiseBasic";
                                                                                     move null to "F1-GetCountryStates";
                                                                                else
                                                                                     move 'N/A' to $fromSaPremiseAddress;
                                                                                end-if;
                                                                                //if("string($todoCreateFlg)= 'Y'")
                                                                                //Current user name
                                                                                move "$USER" to "C1-UserLite/user";
                                                                                invokeBO 'C1-UserLite' using "C1-UserLite" for read;
                                                                                move "concat(C1-UserLite/lastName,', ',C1-UserLite/firstName)" to $userName;
                                                                                //Create To Do
                                                                                move null to "F1-AddToDoEntry";
                                                                                move "$noPaToDoType" to "F1-AddToDoEntry/toDoType";
                                                                                // if ("string($noPaToDoRole) != $BLANK")
                                                                                // move "$noPaToDoRole" to "F1-AddToDoEntry/toDoRole";
                                                                                //end-if;
                                                                                move 'F1_DFLT' to "F1-AddToDoEntry/toDoRole";
                                                                                move '90007' to "F1-AddToDoEntry/messageCategory";
                                                                                move '674' to "F1-AddToDoEntry/messageNumber";
                                                                                move 'SNDR' to "F1-AddToDoEntry/sendTo";
                                                                                move '050' to "F1-AddToDoEntry/priority";
                                                                                move 'O' to "F1-AddToDoEntry/entryStatus";
                                                                                move 'LOWC Enable' to "F1-AddToDoEntry/subject";
                                                                                move "concat('Disconnect date : ',xs:string($stopDate),'\n','CIS Division :',string(csrSABO_schema/division),'\n','Service Types :',string($serviceTypeDesc),'\n','Premise Id :',string(C1-StopServiceRequest/premiseId),'\n','Premise Address :',string($fromSaPremiseAddress),'\n','Customer Class :','Residential')" to "F1-AddToDoEntry/messageParm1";
                                                                                //move "$CURRENT-DTTM" to "F1-AddToDoEntry/createDateTime";
                                                                                // move "$accountId" to "F1-AddToDoEntry/drillKey1";
                                                                                move "$USER" to "F1-AddToDoEntry/sortKey1";
                                                                                move "string($userName)" to "F1-AddToDoEntry/sortKey2";
                                                                                move 'LOWC Enable' to "F1-AddToDoEntry/sortKey3";
                                                                                move "$acctId" to "F1-AddToDoEntry/sortKey4";
                                                                                invokeBS 'F1-AddToDoEntry' using "F1-AddToDoEntry";
                                                                                // ABEHERA END change 1313043
                                                                                // start change ABEHERA Bug: 1300175
                                                                                if ("$acctId != $BLANK")
                                                                                     move "F1-AddToDoEntry/toDoEntryId" to $todoId;
                                                                                     move null to "CM-ToDoCharacteristic";
                                                                                     move "$todoId" to "CM-ToDoCharacteristic/toDoId";
                                                                                     invokeBO 'CM-ToDoCharacteristic' using "CM-ToDoCharacteristic" for read;
                                                                                     move 'C1-ACCT' to "CM-ToDoCharacteristic/+toDoEntryCharacteristic/characteristicType";
                                                                                     move "$acctId" to "CM-ToDoCharacteristic/toDoEntryCharacteristic[last()]/characteristicValueForeignKey1";
                                                                                     invokeBO 'CM-ToDoCharacteristic' using "CM-ToDoCharacteristic" for fastUpdate;
                                                                                end-if;
                                                                                // end change ABEHERA Bug: 1300175
                                                                                //end change bug: 1317256"
                                                                                //end-if;
                                                                           end-if;
                                                                           //7/10
                                                                      end-for;
                                                                      //lowc logic apply
                                                                      //ADO: 1315569 related chnages. start
                                                                      // end-if;
                                                                      //ADO: 1315569 related chnages. end
                                                                 end-if;
                                                            end-if;
                                                       end-if;
                                                  end-if;
                                             end-if;
                                             //terminate with error (90003, 1 %1='Last');
                                             goto 200;
                                             //end-if;
                                        end-if;
                                   end-if;
                                   //7/16 Ado 1239940 if closed
                              end-for;
                              //lowc logic apply
                              //ADO: 1315569 related chnages. start
                              // end-if;
                              //ADO: 1315569 related chnages. end
                         end-if;
                    end-if;
