     void setMecGeneralAdjType(){
       String generalAdjType
       String electricAdjTypes = evalString('$electricAdjTypes');
         String gasAdjTypes = evalString('$gasAdjTypes');
     
             List<String> electricAdjTypesList = new ArrayList<String>();
           List<String> gasAdjTypesList = new ArrayList<String>();
     
     		      String saId = evalString('$transferFromSa');
               ServiceAgreement_Id serviceAgreement_Id = new ServiceAgreement_Id(saId);
               ServiceAgreement curServiceAgreement = serviceAgreement_Id.getEntity();
               ServiceAgreementType curSaType = curServiceAgreement.getServiceAgreementType();
     		  String serviceTypeIdVal = curSaType.getServiceType().getId().getTrimmedValue();
     
     
     
     
               if(electricAdjTypes.contains(",")){
                 for(String elem : electricAdjTypes.split(",")) {
                   electricAdjTypesList.add(elem.trim()) ;
                 }
               }
               else{
                 electricAdjTypesList.add(electricAdjTypes.trim())
               }
     
               if(gasAdjTypes.contains(",")){
                 for(String elem : gasAdjTypes.split(",")) {
                   gasAdjTypesList.add(elem.trim()) ;
                 }
               }
               else{
                 gasAdjTypesList.add(gasAdjTypes.trim())
               }
     
       		            if("E".equals(serviceTypeIdVal)){
     
                 for(String adTyp: electricAdjTypesList){
                   String cisDivAdj = new AdjustmentType_Id(adTyp).getEntity().divisionId.getIdValue()
                   if(cisDivAdj.equals(curServiceAgreement.getServiceAgreementType().fetchIdDivision().getId().getTrimmedValue())){
                     generalAdjType = adTyp
                     setStringScriptVariable('transferAdjustmentType', generalAdjType);
                      //logger.info("Log15 generalAdjType: "+generalAdjType)
                       //logger.info("Log16 generalAdjType: "+evalString('$transferFromSa'))
                        break
                   }
                  // break
                 }
               }
               if("G".equals(serviceTypeIdVal)){
     
                 for(String adTyp: gasAdjTypesList){
                   String cisDivAdj = new AdjustmentType_Id(adTyp).getEntity().divisionId.getIdValue()
                   if(cisDivAdj.equals(curServiceAgreement.getServiceAgreementType().fetchIdDivision().getId().getTrimmedValue())){
                     generalAdjType = adTyp
                     setStringScriptVariable('transferAdjustmentType', generalAdjType);
                      //logger.info("Log17 generalAdjType: "+generalAdjType)
                       //logger.info("Log18 generalAdjType: "+evalString('$transferFromSa'))
                        break
                   }
     
                 //  break
                 }
               }
     
     }
