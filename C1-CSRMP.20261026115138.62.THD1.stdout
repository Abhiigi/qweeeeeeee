   // --  members from step 500 
     Void getElectricNewSaList(){
         String accountId = evalString('$transferToAccount');
         //**** String saType = evalString('$miscSaTypeNonCuttable');
     
               PreparedStatementQuery psQuery = createPreparedStatement(
                 """
                SELECT SA_ID,
            SVC_TYPE_CD
     FROM (
         SELECT SA.SA_ID,
                SAT.SVC_TYPE_CD,
                ROW_NUMBER() OVER (
                    PARTITION BY SAT.SVC_TYPE_CD
                    ORDER BY SA.SA_ID
                ) AS RN
         FROM CI_SA SA,
              CI_SA_TYPE SAT
         WHERE SA.ACCT_ID = :accountId
           AND SA.SA_TYPE_CD = SAT.SA_TYPE_CD
           AND SA.CIS_DIVISION = SAT.CIS_DIVISION
           AND SAT.SVC_TYPE_CD IN ('E')
       AND SA.SA_STATUS_FLG IN ('10','20','30')
     )
     WHERE RN = 1
     ORDER BY CASE
                WHEN SVC_TYPE_CD = 'E' THEN 1
                WHEN SVC_TYPE_CD = 'G' THEN 2
              END
               """, 'Select Statement')
     
               psQuery.bindString("accountId", accountId,"ACCT_ID");
          //  psQuery.bindString("saType", saType,"sa_type_cd");
     
               List<SQLResultRow> queryResults = psQuery.list();
     
               psQuery.close();
     
               if(queryResults.size() > 0) {
                 setStringScriptVariable("electricNewSa", 'true')
     
                       SQLResultRow result = psQuery.firstRow();
     
               if (!isNull(result)){
               String vElectricNewSaId = result.getString('SA_ID');
                setStringScriptVariable('electricNewSaId', vElectricNewSaId);
             }
               }
                 else {
               setStringScriptVariable("electricNewSa", 'false')
               }
             }
     
     
     Void getGasNewSaList(){
         String accountId = evalString('$transferToAccount');
         //**** String saType = evalString('$miscSaTypeNonCuttable');
     
               PreparedStatementQuery psQuery = createPreparedStatement(
                 """
                SELECT SA_ID,
            SVC_TYPE_CD
     FROM (
         SELECT SA.SA_ID,
                SAT.SVC_TYPE_CD,
                ROW_NUMBER() OVER (
                    PARTITION BY SAT.SVC_TYPE_CD
                    ORDER BY SA.SA_ID
                ) AS RN
         FROM CI_SA SA,
              CI_SA_TYPE SAT
         WHERE SA.ACCT_ID = :accountId
           AND SA.SA_TYPE_CD = SAT.SA_TYPE_CD
           AND SA.CIS_DIVISION = SAT.CIS_DIVISION
           AND SAT.SVC_TYPE_CD IN ('G')
       AND SA.SA_STATUS_FLG IN ('10','20','30')
     )
     WHERE RN = 1
     ORDER BY CASE
                WHEN SVC_TYPE_CD = 'E' THEN 1
                WHEN SVC_TYPE_CD = 'G' THEN 2
              END
               """, 'Select Statement')
     
               psQuery.bindString("accountId", accountId,"ACCT_ID");
           // psQuery.bindString("saType", saType,"sa_type_cd");
     
               List<SQLResultRow> queryResults = psQuery.list();
     
               psQuery.close();
     
               if(queryResults.size() > 0) {
                 setStringScriptVariable("gasNewSa", 'true')
     
                       SQLResultRow result = psQuery.firstRow();
     
               if (!isNull(result)){
               String vGasNewSaId = result.getString('SA_ID');
                setStringScriptVariable('gasNewSaId', vGasNewSaId);
             }
               }
                 else {
               setStringScriptVariable("gasNewSa", 'false')
               }
             }
