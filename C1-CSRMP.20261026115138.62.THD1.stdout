   // --  members from step 440 
     void createTodoEntry(String messageCat, String messageNumber, ServiceAgreement sa, CharacteristicType accountdIdCharType, CharacteristicType personIdCharType, CharacteristicType premiseIdCharType, ToDoType_Id spTodoTypeSaId){
       	def messageCategoryId = new MessageCategory_Id(new BigInteger (messageCat));
         def messageId = new Message_Id(messageCategoryId, new BigInteger (messageNumber));
       	Account account = sa.getAccount();
     
       	ToDoEntry_DTO toDoEntryDTO = (ToDoEntry_DTO) createDTO(ToDoEntry.class);
         //toDoEntryDTO.setToDoTypeId(spToDoTypeLlBasedSas.getId());
       	toDoEntryDTO.setToDoTypeId(spTodoTypeSaId);
       	//toDoEntryDTO.setToDoRoleId(spToDoTypeLlBasedSas.getDefaultRole().getId().getToDoRoleId());
       	toDoEntryDTO.setToDoRoleId(spTodoTypeSaId.getEntity().getDefaultRole().getId().getToDoRoleId());
     
         toDoEntryDTO.setToDoEntryStatus(ToDoEntryStatusLookup.constants.OPEN);
         toDoEntryDTO.setCreationDateTime(getProcessDateTime());
     
       	// Set the Message
         toDoEntryDTO.setMessageId(messageId);
         ToDoCreator toDoCreator = ToDoCreator.Factory.newInstance();
         toDoCreator.setToDoDTO(toDoEntryDTO);
     
         // Add the sort keys
         //def toDoTypeSortKeyTypes = spToDoTypeLlBasedSas.getSortKeyTypes();
       	def toDoTypeSortKeyTypes = spTodoTypeSaId.getEntity().getSortKeyTypes();
         Iterator<ToDoSortKeyType> sortKeyIterator = toDoTypeSortKeyTypes.iterator();
     
         // Only get the first one
         ToDoSortKeyType toDoSortKeyType = sortKeyIterator.next();
         toDoCreator.addSortKeyValue(toDoSortKeyType, account.getId().getTrimmedValue());
     
         // Add the drill keys
         //Iterator<ToDoDrillKeyType> toDoTypeDrillKeyTypes = spToDoTypeLlBasedSas.getDrillKeyTypes().iterator();
       	Iterator<ToDoDrillKeyType> toDoTypeDrillKeyTypes = spTodoTypeSaId.getEntity().getDrillKeyTypes().iterator();
         ToDoDrillKeyType todoDrillKeyType = toDoTypeDrillKeyTypes.next();
         toDoCreator.addDrillKeyValue(todoDrillKeyType, account.getId().getTrimmedValue());
     
         // Add the characteristics
         //def toDoTypeCharacteristicTypes = spToDoTypeLlBasedSas.getCharacteristicControls();
       	def toDoTypeCharacteristicTypes = spTodoTypeSaId.getEntity().getCharacteristicControls();
         ToDoCharacteristicData toDoCharacteristicData = null;
         ToDoEntryCharacteristic_DTO toDoEntryCharDTO = null;
     
         for (ToDoTypeCharacteristicControl toDoCharType : toDoTypeCharacteristicTypes) {
           toDoCharacteristicData = ToDoCharacteristicData.Factory.newInstance();
           toDoEntryCharDTO = toDoCharacteristicData.getDTO();
           BigInteger toDoCharIdSeq = toDoCharType.getSortSequence();
           toDoEntryCharDTO.setId(new ToDoEntryCharacteristic_Id(ToDoEntry_Id.NULL, toDoCharType
                                  .fetchIdCharacteristicType().getId(), toDoCharIdSeq));
     
           //Account account = sa.getAccount();
     
           if (toDoCharType.fetchIdCharacteristicType().equals(accountdIdCharType)) {
     
             toDoEntryCharDTO.setCharacteristicValueForeignKey1(account.getId().getTrimmedValue());
     
           }
     
           if (toDoCharType.fetchIdCharacteristicType().equals(personIdCharType)) {
             toDoEntryCharDTO.setCharacteristicValueForeignKey1(account.getMainPerson().getId().getTrimmedValue());
     
           }
     
           if (!isNull(premiseIdCharType) && toDoCharType.fetchIdCharacteristicType().equals(premiseIdCharType)) {
     
             //retrieve first premise entity
             def premiseEntity = sa.retrieveSASPPremises(getProcessDateTime(), getProcessDateTime()).get(0)
             toDoEntryCharDTO.setCharacteristicValueForeignKey1(premiseEntity.getId().getTrimmedValue());
     
           }
     
       /*
       	  toDoCharacteristicData.setDTO(toDoEntryCharDTO);
           toDoCreator.addCharacteristic(toDoCharacteristicData);
        */
         }
         // Create ToDoEntry
     
         ToDoEntry toDoEntry = toDoCreator.create();
       //logger.info("todoId value: "+toDoEntry.getId().getIdValue()+" for SA: "+sa.getId().getIdValue())
     
     }
