               move "normalize-space(concat($toSaPremiseAddress, ', ', F1-GetCountryStates/states[state=$currentState]/description))" to $toSaPremiseAddress;
          end-if;
          move null to "C1-PremiseBasic";
          move null to "F1-GetCountryStates";
          move "$toSaPremiseAddress" to $inputString;
          invokeGroovy 'convertToTitleCase';
          move "$outputString" to $toSaPremiseAddress;
     else
          move 'N/A' to $toSaPremiseAddress;
     end-if;
     // Get the Transfer From Premise Details
