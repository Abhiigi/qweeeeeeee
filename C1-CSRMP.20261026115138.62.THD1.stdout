     List<SQLResultRow> getCuttableOldSaList(String accountId,String miscSaTypeCuttable){
           ArrayList<String> listVal = new ArrayList<String>();
           PreparedStatementQuery psQuery = createPreparedStatement(
             """
           select SA.SA_ID,SAT.SVC_TYPE_CD from CI_SA SA,CI_SA_TYPE SAT
             where trim(SA.sa_type_cd) = :saType and
             SA.acct_id = :accountId and
             SA.SA_STATUS_FLG in ('40') and
             SA.CIS_DIVISION = SAT.CIS_DIVISION and
             SA.SA_TYPE_CD = SAT.SA_TYPE_CD
             """, 'Select Statement')
     
         psQuery.bindString("accountId", accountId,"ACCT_ID");
        psQuery.bindString("saType", miscSaTypeCuttable,"sa_type_cd");
     
           List<SQLResultRow> queryResults = psQuery.list();
           //addError(90001,5,serviceType)
           psQuery.close();
     
           if(queryResults.size() > 0){
     
              //logger.info("log13 getCuttableOldSaList");
     
             return queryResults
           }
           return null
         }
