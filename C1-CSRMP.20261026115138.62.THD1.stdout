     public void createFrozenTransferAdjustment() {
     
       	CreateFrozenAdjustmentData frozenAdjustmentData = CreateFrozenAdjustmentData.Factory.newInstance();
       	frozenAdjustmentData.setServiceAgreement(new ServiceAgreement_Id(evalString('$transferFromSa')).getEntity());
       	frozenAdjustmentData.setTransferServiceAgreement(new ServiceAgreement_Id(evalString('$transferToSa')).getEntity());
       	frozenAdjustmentData.setAdjustmentType(new AdjustmentType_Id(evalString('$transferAdjustmentType')).getEntity());
       	frozenAdjustmentData.setAdjustmentAmount(new Money(evalString('$adjustmentAmount')));
       	frozenAdjustmentData.setAdjustmentDate(getProcessDateTime().getDate());
         frozenAdjustmentData.setArrearsDate(evalDate('$arrearsDate'));
     
     
       	frozenAdjustmentData.setAllowZeroAmount(Bool.FALSE);
       	CreateFrozenAdjustment createFrozenAdjustment = CreateFrozenAdjustment.Factory.newInstance();
     
       	frozenAdjustmentData = createFrozenAdjustment.createFrozenAdjustment(frozenAdjustmentData);
     
       	Adjustment_Id adjustmentId = frozenAdjustmentData.getAdjustment().getId();
         setStringScriptVariable("adjustmentId", adjustmentId.getTrimmedValue());
       //logger.info("coming here") ;
     
     }
