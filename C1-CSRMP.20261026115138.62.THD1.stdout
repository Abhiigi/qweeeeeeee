   // --  members from step 430 
     Boolean checkIfTodoExists(String accountId,String todoTypeCd,Date creDate,String messageCat, String messageNum){
       PreparedStatementQuery psQuery = createPreparedStatement(
         """
        SELECT 1
             FROM CI_TD_ENTRY TDE
             WHERE TRIM(TDE.TD_TYPE_CD) = TRIM(:todoTypeCd)
             AND TRUNC(TDE.CRE_DTTM) <= :creDate
             AND ENTRY_STATUS_FLG <> 'C'
           AND MESSAGE_CAT_NBR = :messageCat
           AND MESSAGE_NBR = :messageNum
           AND (
             EXISTS (
               SELECT 1
               FROM CI_TD_SRTKEY SRT
               WHERE SRT.TD_ENTRY_ID = TDE.TD_ENTRY_ID
               AND TRIM(SRT.KEY_VALUE) = :accountId
           )
           OR
           EXISTS (
             SELECT 1
             FROM CI_TD_DRLKEY DRL
             WHERE DRL.TD_ENTRY_ID = TDE.TD_ENTRY_ID
             AND TRIM(DRL.KEY_VALUE) = :accountId
           )
           )
       """, 'Select Statement')
     
       psQuery.bindString("accountId", accountId,"KEY_VALUE");
       psQuery.bindString("todoTypeCd", todoTypeCd,"TD_TYPE_CD");
       psQuery.bindDate("creDate",creDate)
       psQuery.bindString("messageCat", messageCat,"MESSAGE_CAT_NBR");
       psQuery.bindString("messageNum", messageNum,"MESSAGE_NBR");
     
       List<SQLResultRow> queryResults = psQuery.list();
       //addError(90003,1603, 'Test');
       psQuery.close();
     
       if(queryResults.size() > 0){
         return true
       }
       return false
     }
