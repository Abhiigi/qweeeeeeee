          move "string(C1ServiceAgreementPhysical/premiseId)" to $fromSaPremiseId;
          move null to "C1ServiceAgreementPhysical";
     end-if;
     if ("string($fromSaPremiseId) != $BLANK")
          move null to "C1-PremiseBasic";
          move "$fromSaPremiseId" to "C1-PremiseBasic/premiseId";
