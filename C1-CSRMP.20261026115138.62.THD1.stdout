     				AND B.CIS_DIVISION = C.CIS_DIVISION
     				AND B.SA_TYPE_CD = C.SA_TYPE_CD
     				AND C.SPECIAL_ROLE_FLG NOT IN ('CD','LO','NB')
     				AND C.SVC_TYPE_CD <> 'M'
                     AND trim(C.REV_CL_CD) = :revenueClass
     	            """, 'Retrieve CS Request SA');
     
     
       	query.bindString("custSvcReqId", csrId, 'CS_REQ_ID');
       	query.bindString("revenueClass", revenueClass, 'REV_CL_CD');
     
       	SQLResultRow result = query.firstRow();
     
