   // --  members from step 380 
     void cuttableSAProc(){
     
        List<String> electricAdjTypesList = new ArrayList<String>();
     
       List<SQLResultRow> saList = getCuttableOldSaList(evalString('$transferFromAccount'),evalString('$miscSaTypeCuttable'))
     
       if(saList){
         for(SQLResultRow saRow:saList){
           String saId = saRow.getString("SA_ID").trim()
           ServiceAgreement_Id serviceAgreement_Id = new ServiceAgreement_Id(saId)
           ServiceAgreement curServiceAgreement = serviceAgreement_Id.getEntity();
               ServiceAgreementType curSaType = curServiceAgreement.getServiceAgreementType();
               String curSaTypeValue = curSaType.getId().getSaType()
               ServiceAgreementBalanceData curSaBalances = curServiceAgreement.getFinancialBalances();
               String generalAdjType = evalString('$spAdjTypeForMiscCuttable');
               Money adjAmountOfAll = new Money(curSaBalances.getCurrentAmount().getAmount(), curSaBalances.getCurrentAmount().getCurrencyId());
     
           //set cuttable adj type base on cis division
           List<String> cuttableAdjTypesList = new ArrayList<String>();
     
           String serviceTypeIdVal = curSaType.getServiceType().getId().getTrimmedValue();
     
             if(generalAdjType.contains(",")){
                 for(String elem : generalAdjType.split(",")) {
                   cuttableAdjTypesList.add(elem.trim()) ;
                 }
               }
               else{
                 cuttableAdjTypesList.add(generalAdjType.trim())
               }
     
     
             		            if("M".equals(serviceTypeIdVal)){
                 for(String adTyp: cuttableAdjTypesList){
                   String cisDivAdj = new AdjustmentType_Id(adTyp).getEntity().divisionId.getIdValue()
                   if(cisDivAdj.equals(curServiceAgreement.getServiceAgreementType().fetchIdDivision().getId().getTrimmedValue())){
                     generalAdjType = adTyp
                     //setStringScriptVariable('transferAdjustmentType', generalAdjType);
                      //logger.info("Log50 generalAdjType: "+generalAdjType)
                       //logger.info("Log51 generalAdjType: "+saId)
                       break
                   }
     
                 }
               }
     
     
     
           //set cuttable adj type base on cis division end
     
     
     
     
     
           getCuttableNewSaList()
     
     if(evalString('$cuttableNewSa') == 'true'){
     
       String hasToTransferMiscToSa =  evalString('$cuttableNewSaId');
     
         //create adj for cuttable
                           createFrozenAdjustment(curServiceAgreement, new ServiceAgreement_Id(hasToTransferMiscToSa).getEntity(), new AdjustmentType_Id(generalAdjType).getEntity(), adjAmountOfAll, getProcessDateTime().getDate(), Bool.FALSE)
     
     
     
     }
           else{
             //create new SA
                               String newMiscSa = createServiceAgreement(new ServiceAgreement_Id(evalString('$transferToSa')).getEntity().getAccount().getId().getIdValue(),new ServiceAgreement_Id(evalString('$transferToSa')).getEntity().getAccount().getDivisionId().getIdValue(),curSaTypeValue)
     
             // then create Adj cuttable
                         createFrozenAdjustment(curServiceAgreement, new ServiceAgreement_Id(newMiscSa).getEntity(), new AdjustmentType_Id(generalAdjType).getEntity(), adjAmountOfAll, getProcessDateTime().getDate(), Bool.FALSE)
           }
     
         }
     
     
         }
       //logger.info("log22 end cuttableSAProc");
     }
   // --  end members from step 380 


   // --  members from step 385 
     void nonCuttableSAProc(){
     
       List<SQLResultRow> saList = getNonCuttableOldSaList(evalString('$transferFromAccount'),evalString('$miscSaTypeNonCuttable'))
         if(saList){
         for(SQLResultRow saRow:saList){
           String saId = saRow.getString("SA_ID").trim()
           ServiceAgreement_Id serviceAgreement_Id = new ServiceAgreement_Id(saId)
           ServiceAgreement curServiceAgreement = serviceAgreement_Id.getEntity();
               ServiceAgreementType curSaType = curServiceAgreement.getServiceAgreementType();
               //String curSaTypeValue = curSaType.toString();
               String curSaTypeValue = curSaType.getId().getSaType()
               ServiceAgreementBalanceData curSaBalances = curServiceAgreement.getFinancialBalances();
               String generalAdjType = evalString('$spAdjTypeForMiscNonCuttable');
               Money adjAmountOfAll = new Money(curSaBalances.getCurrentAmount().getAmount(), curSaBalances.getCurrentAmount().getCurrencyId());
     
     
                 //set noncuttable adj type base on cis division
           List<String> noncuttableAdjTypesList = new ArrayList<String>();
     
           String serviceTypeIdVal = curSaType.getServiceType().getId().getTrimmedValue();
     
             if(generalAdjType.contains(",")){
                 for(String elem : generalAdjType.split(",")) {
                   noncuttableAdjTypesList.add(elem.trim()) ;
                 }
               }
               else{
                 noncuttableAdjTypesList.add(generalAdjType.trim())
               }
     
     
             		            if("M".equals(serviceTypeIdVal)){
                 for(String adTyp: noncuttableAdjTypesList){
                   String cisDivAdj = new AdjustmentType_Id(adTyp).getEntity().divisionId.getIdValue()
                   if(cisDivAdj.equals(curServiceAgreement.getServiceAgreementType().fetchIdDivision().getId().getTrimmedValue())){
                     generalAdjType = adTyp
                     //setStringScriptVariable('transferAdjustmentType', generalAdjType);
                      //logger.info("Log52 generalAdjType: "+generalAdjType)
                       //logger.info("Log53 generalAdjType: "+saId)
                       break
                   }
     
                 }
               }
     
     
     
           //set cuttable adj type base on cis division end
     
     
     
     
           getNonCuttableNewSaList()
     
     if(evalString('$nonCuttableNewSa') == 'true'){
     
       String hasToTransferMiscToSa =  evalString('$nonCuttableNewSaId');
     
         //create adj for cuttable
                           createFrozenAdjustment(curServiceAgreement, new ServiceAgreement_Id(hasToTransferMiscToSa).getEntity(), new AdjustmentType_Id(generalAdjType).getEntity(), adjAmountOfAll, getProcessDateTime().getDate(), Bool.FALSE)
     
     
     
     }
           else{
             //create new SA
                               String newMiscSa = createServiceAgreement(new ServiceAgreement_Id(evalString('$transferToSa')).getEntity().getAccount().getId().getIdValue(),new ServiceAgreement_Id(evalString('$transferToSa')).getEntity().getAccount().getDivisionId().getIdValue(),curSaTypeValue)
     
             // then create Adj cuttable
                         createFrozenAdjustment(curServiceAgreement, new ServiceAgreement_Id(newMiscSa).getEntity(), new AdjustmentType_Id(generalAdjType).getEntity(), adjAmountOfAll, getProcessDateTime().getDate(), Bool.FALSE)
           }
     
         }
     
     
         }
     }
   // --  end members from step 385 


   // --  members from step 390 
     String createServiceAgreement(String accountId, String cisDivision, String saType){
       move null, "C1-ServiceAgreement";
       move accountId, "C1-ServiceAgreement/accountId";
       move cisDivision, "C1-ServiceAgreement/division";
       move evalDate('$CURRENT-DATE'), "C1-ServiceAgreement/startDate";
       move saType, "C1-ServiceAgreement/saType";
       move "10", "C1-ServiceAgreement/status";
       invokeBO BusinessObjectActionLookup.constants.ADD, "C1-ServiceAgreement", "C1-ServiceAgreement"
       if(!isEmptyOrNull(evalString("C1-ServiceAgreement/saId"))){
         return evalString("C1-ServiceAgreement/saId")
       }
       return null
     }
   // --  end members from step 390 


   // --  members from step 400 
     public void createFrozenAdjustment(ServiceAgreement sa,ServiceAgreement matchedSa, AdjustmentType adjType, Money adjAmount, Date adjDate, Bool spSendLetterToCustomer){
     	CreateFrozenAdjustmentData frozenAdjustmentData = CreateFrozenAdjustmentData.Factory.newInstance();
         frozenAdjustmentData.setServiceAgreement(sa);
       	frozenAdjustmentData.setTransferServiceAgreement(matchedSa);
         frozenAdjustmentData.setAdjustmentType(adjType);
         frozenAdjustmentData.setAdjustmentAmount(adjAmount);
         frozenAdjustmentData.setAdjustmentDate(adjDate);
         frozenAdjustmentData.setAllowZeroAmount(Bool.FALSE);
     
         CreateFrozenAdjustmentData createFrozenAdjustmentData = sa.createFrozenAdjustment(frozenAdjustmentData);
       	// get adjustment ID
       	Adjustment_Id adjustmentId = createFrozenAdjustmentData.getAdjustment().getId();
     
       	ServiceScriptInstance transferRuleScript = ServiceScriptInstance.create("CMDbTrnRulME");
         COTSInstanceNode inputGroup = transferRuleScript.getGroup("input");
         inputGroup.set("transferFromSa", sa.getId().getTrimmedValue());
       	inputGroup.set("transferToSa", matchedSa.getId().getTrimmedValue());
       	inputGroup.set("sendLetterToCustomer",  spSendLetterToCustomer);
       	inputGroup.set("sendLetterOnly", Bool.TRUE);
       	inputGroup.set("adjustmentType",  adjType.getId().getIdValue());
       	inputGroup.set("adjustmentId",  adjustmentId.getTrimmedValue());
     
     	ServiceScriptDispatcher.invoke(transferRuleScript);
       //addError(90001,5,'test')
     
     }
   // --  end members from step 400 


   // --  members from step 410 
     public boolean isAccountHasActiveBankruptcy(Account accountId) {
     	ServiceAgreementStatusLookup activeSAStatus = ServiceAgreementStatusLookup.constants.ACTIVE;
     	ServiceAgreementStatusLookup pendingStoppedSAStatus = ServiceAgreementStatusLookup.constants.PENDING_STOP;
       	ServiceAgreementStatusLookup stoppedSAStatus = ServiceAgreementStatusLookup.constants.STOPPED;
     
     	StringBuilder saTypesBuilder = new StringBuilder();
         Integer counter = 0;
       	String queryStr = null
         String[] saTypes = null
     
         String spBankruptcySAType = evalString('$spBankruptcySAType');
     
       	if(spBankruptcySAType.contains(",")){
             saTypes = spBankruptcySAType.split(',');
           	queryStr = "'"
             for (String saType : saTypes) {
               /*
               saTypesBuilder.append(":saType" + counter);
               if (counter < saTypes.size() - 1) {
                   saTypesBuilder.append(", ");
                   counter++;
               }
               */
               queryStr = queryStr+saType.trim()+"','"
             }
     		//queryStr = builder.toString().replaceAll("-saTypes-", saTypesBuilder.toString());
           	queryStr = queryStr.substring(0,queryStr.length()-2)
         }
         else{
           //queryStr = builder.toString().replaceAll("-saTypes-", spBankruptcySAType.trim());
           queryStr = "'"+spBankruptcySAType.trim()+"'"
         }
     
       StringBuilder builder = new StringBuilder();
     	builder.append("SELECT SA.SA_ID ");
     	builder.append("FROM CI_SA SA ");
     	builder.append("WHERE SA.ACCT_ID = :accountId ");
     	//builder.append("AND SA.SA_TYPE_CD IN (-saTypes-) ");
       	builder.append("AND SA.SA_TYPE_CD IN ("+queryStr+") ");
     	builder.append("AND SA.SA_STATUS_FLG IN (:activeSAStatus, :pendingStoppedSAStatus, :stoppedSAStatus)");
     
     
     	StringBuilder queryStrBuild = new StringBuilder();
         //queryStrBuild.append(queryStr);
       queryStrBuild.append(builder.toString());
     
     
     	PreparedStatementQuery psQuery = createPreparedStatement(new StringBuffer(" ").append(builder.toString()).toString(), "isAccountHasActiveBankruptcy");
     	psQuery.bindEntity("accountId", accountId);
     	psQuery.bindLookup("activeSAStatus",activeSAStatus);
     	psQuery.bindLookup("pendingStoppedSAStatus",pendingStoppedSAStatus);
         psQuery.bindLookup("stoppedSAStatus",stoppedSAStatus);
       	//psQuery.bindString("queryStr",queryStr,'SA_TYPE_CD')
     	counter = 0;
       /*
         for (String satype : saTypes) {
           	psQuery.bindString("saType" + counter, satype, 'SA_TYPE_CD');
           	counter++;
         }
         */
     
       //addError(90003,1603, psQuery.toString());
       SQLResultRow row = psQuery.firstRow();
     
       	if (row != null) {
           	//if (row.getInteger("COUNT(*)") != 0) {
         		return true;
             //}
         }
       	return false;
     }
   // --  end members from step 410 


   // --  members from step 420 
     void checkValidRecord(){
       //logger.info("checkValidRecord IN ");
     
       ToDoType_Id spTodoTypeResSaId
     
               CharacteristicType accountIdCharTypeEntity = new CharacteristicType_Id("C1_ACCT").getEntity()
           CharacteristicType personIdCharTypeEntity = new CharacteristicType_Id("C1_PER").getEntity()
           CharacteristicType premiseIdCharTypeEntity = new CharacteristicType_Id("C1_PREM").getEntity()
     
     
       Account_Id accountId1 = new Account_Id(evalString('$transferFromAccount'));
       Account account = accountId1.getEntity();
     
       String acctCustomerClass = account.getCustomerClass().getId().getTrimmedValue() ;
     
                 String saId = evalString('$transferFromSa');
                     ServiceAgreement_Id ser_id = new ServiceAgreement_Id(saId) ;
           ServiceAgreement hpServiceAgreement = ser_id.getEntity();
     
             ServiceAgreementType saType = hpServiceAgreement.getServiceAgreementType();
           String saTypeValue = saType.getId().getSaType();
     
            spTodoTypeResSaId = new ToDoType_Id(evalString('$spTodoTypeResSa'))
     
            ServiceAgreementBalanceData saBalances = hpServiceAgreement.getFinancialBalances();
     
             //Active bankcrupcy validation
     
       if (isAccountHasActiveBankruptcy(account)){
     
                 String description= "Debit transfer cannot be performed because account has active bankruptcy";
             String messageCat = "90003";
             String messageNum = "12345";
             if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
     
     
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
             }
         setStringScriptVariable("checkValidRecord", "false")
             return
       }
        //Active bankcrupcy validation End
     
     
             //account NOXFER char type validation
          String spNoTransferCharType = evalString('$spNoTransferCharType')
           if(!isEmptyOrNull(spNoTransferCharType)){
     
           StringBuilder builder = new StringBuilder();
           builder.append("SELECT ACCT_ID FROM CI_ACCT_CHAR ");
           builder.append("WHERE ACCT_ID = :acctId ");
           builder.append("AND trim(CHAR_TYPE_CD) = trim(:chartype) ");
           builder.append("AND trim(CHAR_VAL) = trim(:chartypeval) ");
     
           PreparedStatementQuery psQuery = createPreparedStatement(new StringBuffer(" ").append(builder.toString()).toString(),"CheckAccountCharacteristics");
           psQuery.bindString("acctId",evalString('$transferFromAccount'),"ACCT_ID");
           psQuery.bindString("chartype",evalString('$spNoTransferCharType'),"CHAR_TYPE_CD") ;
           psQuery.bindString("chartypeval",evalString('$spNoTransferCharVal'),"CHAR_VAL") ;
     
           SQLResultRow result = psQuery.firstRow();
     
           psQuery.close()
           //logger.info("before nox if:"+saId);
           if(result!=null){
             //logger.info("inside nox if:"+saId);
     
             //create todo
             String description= "Debit transfer cannot be performed because account has Non Transfer Charecteristic";
             String messageCat = "90003";
             String messageNum = "12349";
             //Sagar
             if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
               //logger.info("inside checktodo nox if:");
               //addError(90001,5,"before todo")
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
     
               //logger.info("after create todo nox if:");
             }
     
             setStringScriptVariable("checkValidRecord", "false")
             return
           }
     
     }
       //account NOXFER char type validation end
     
     
       //logger.info("log2 spExRevClass"+evalString('$spExRevClass'));
            //REVENUE CLASS VALIDATION CHECK
        String spExRevClass = evalString('$spExRevClass');
           if(!isEmptyOrNull(spExRevClass)){
             if(spExRevClass.contains(",")){
               for(String revClass:spExRevClass.trim().split(",")){
                 if(revClass.trim().equals(hpServiceAgreement.getServiceAgreementType().getRevenueClassId().getTrimmedValue())){
                   String description= "Debit Transfer could not be performed as the revenue class is exempted";
                   String messageCat = "90003";
                   String messageNum = "12352";
                   if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
                   }
                   setStringScriptVariable("checkValidRecord", "false")
                   return
                 }
               }
             }
             else{
               if(spExRevClass.trim().equals(hpServiceAgreement.getServiceAgreementType().getRevenueClassId().getTrimmedValue())){
                 String description= "Debit Transfer could not be performed as the revenue class is exempted";
                 String messageCat = "90003";
                 String messageNum = "12352";
                 if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
                 }
                 setStringScriptVariable("checkValidRecord", "false")
                 return
               }
             }
           }
     
        //logger.info("log3 spExRevClass"+evalString('$spExCustomerClass'));
           //customer class exclusion logic
          String spExCustomerClass = evalString('$spExCustomerClass');
       List<String> CustomerClassList = new ArrayList<String>();
     
           if(!isEmptyOrNull(spExCustomerClass)){
     
           if(spExCustomerClass.contains(",")){
             for(String Customer :spExCustomerClass.split(",")) {
               CustomerClassList.add(Customer.trim()) ;
             }
           }
           else{
             CustomerClassList.add(spExCustomerClass.trim())
           }
     
     
           if(!isEmptyOrNull(acctCustomerClass)){
             if(CustomerClassList.contains(acctCustomerClass)){
               //Create To Do
               String description= "Debit transfer cannot be perfomed as customer class is exempted";
               String messageCat = "90003";
               String messageNum = "12346";
               if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
               }
               setStringScriptVariable("checkValidRecord", "false")
               return
             }
           }
           }
       //customer class exclusion logic end
         //logger.info("log4 spNonServiceSaType"+evalString('$spNonServiceSaType'));
             //Non service SA type validation
            String spNonServiceSaType = evalString('$spNonServiceSaType');
        List<String> nonServicesList = new ArrayList<String>();
     
            if(!isEmptyOrNull(spNonServiceSaType)){
           if(spNonServiceSaType.contains(",")){
             for (String nonService :spNonServiceSaType.split(",")){
               nonServicesList.add(nonService)
             }
           }
           else{
             nonServicesList.add(spNonServiceSaType.trim())
           }
     
           if(nonServicesList.contains(saTypeValue)){
             //Create To Do
             String description= "Debit Transfer cannnot be performed Sa type is not servicable";
             String messageCat = "90003";
             String messageNum = "12348";
             //sagar
             if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
             }
             setStringScriptVariable("checkValidRecord", "false")
             return
           }
            }
       //Non service SA type validation end
     
           //logger.info("log5 PROCESSING SA HAS LANDLORD");
             //IF THE PROCESSING SA HAS LANDLORD
     
           if(isSAHasLandlordAgreement(hpServiceAgreement) == true){
     
             String description= "Debit Transfer could not be performed as the SA is linked with a landlord agreement";
             String messageCat = "90003";
             String messageNum = "12351";
             if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
             }
              setStringScriptVariable("checkValidRecord", "false")
             return
           }
       //IF THE PROCESSING SA HAS LANDLORD End
     
      // evalString('$spDebitBalThresholdNonRes')
           //logger.info("log6 acctCustomerClass"+acctCustomerClass);
             //THRESHOLD CHECK FOR SA CURRENT BALANCE WRT CUSTOMER CLASS
           if(acctCustomerClass.equals("R")){
             if(saBalances.getCurrentAmount().getAmount().compareTo(new BigDecimal(evalString('$spDebitBalThresholdRes'))) > 0){
               String description= "Debit Transfer could not be performed as the balance exceeds the defined threshold";
               String messageCat = "90003";
               String messageNum = "12353";
               if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
               }
               setStringScriptVariable("checkValidRecord", "false")
               return
             }
           }
           else{
             if(saBalances.getCurrentAmount().getAmount().compareTo(new BigDecimal(evalString('$spDebitBalThresholdNonRes'))) > 0){
               String description= "Debit Transfer could not be performed as the balance exceeds the defined threshold";
               String messageCat = "90003";
               String messageNum = "12353";
               if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
               }
               setStringScriptVariable("checkValidRecord", "false")
               return
             }
           }
       //THRESHOLD CHECK FOR SA CURRENT BALANCE WRT CUSTOMER CLASS END
     
     
               //LIHEAP protected account validation
       String liheapSaType = evalString('$liheapSaType');
       String saStatusFlg = evalString('$saStatusFlg');
        if(!isEmptyOrNull(liheapSaType)){
          // addError(90001,5,"inside liheapSaType")
           StringBuilder builderL = new StringBuilder();
           builderL.append("SELECT SA_ID FROM CI_SA ");
           builderL.append("WHERE ACCT_ID = :acctId ");
           builderL.append("and trim(sa_type_cd) = trim(:liheapSaType) ");
           builderL.append("and SA_STATUS_FLG = :saStatusFlg ");
     
           PreparedStatementQuery psQueryL = createPreparedStatement(new StringBuffer(" ").append(builderL.toString()).toString(),"CheckAccountLiheapSA");
           psQueryL.bindString("acctId",evalString('$transferFromAccount'),"ACCT_ID");
           psQueryL.bindString("liheapSaType",evalString('$liheapSaType'),"sa_type_cd") ;
           psQueryL.bindString("saStatusFlg",evalString('$saStatusFlg'),"SA_STATUS_FLG") ;
     
           SQLResultRow resultL = psQueryL.firstRow();
     
           psQueryL.close()
              if(resultL){
     
             //create todo
             String description= "Debit transfer cannot be performed because account is LIHEAP protected ";
             String messageCat = "90003";
             String messageNum = "12354";
     
             if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
               //logger.info("inside checktodo nox if:");
     
                 createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
               //logger.info("after create todo nox if:");
             }
             //logger.info("before return for todo:");
             setStringScriptVariable("checkValidRecord", "false")
              //logger.info("checkValidRecord false for LIHEAP SA");
             return
           }
        }
       //LIHEAP protected account validation end
     
     
       //ACCOUNT MAIN PERSON MARRIAGE/DIVORCE/SEPARATION CHECK new
       //get Write off process id from transfer from SA
       getWOPId()
       getMainPerson()
     
       default $vPartialDebtPresent;
       move null,"CMDbtMrgRMEC";
       move evalString('$transferFromAccount'),"CMDbtMrgRMEC/input/AccountId";
       move evalString('$vWopId'),"CMDbtMrgRMEC/input/wopId";
       move evalString('$transferFromSa'),"CMDbtMrgRMEC/input/transferFromSa";
       move evalString('$personId'),"CMDbtMrgRMEC/input/csrPerId";
       invokeSS 'CMDbtMrgRMEC',"CMDbtMrgRMEC";
     
     
       String vPartialDebtPresent = evalString("CMDbtMrgRMEC/output/partialDebtPresent");
     
       if("true".equals(vPartialDebtPresent)){
     
     
         //create todo
             String description= "Debit transfer cannot be performed because partial debt exist for marriage tenure";
             String messageCat = "90003";
             String messageNum = "12350";
     
             if(!checkIfTodoExists(evalString('$transferFromAccount'),evalString('$spTodoTypeResSa'),getProcessDateTime().getDate(),messageCat,messageNum)){
               createTodoEntry(messageCat,messageNum, hpServiceAgreement, accountIdCharTypeEntity, personIdCharTypeEntity, premiseIdCharTypeEntity, spTodoTypeResSaId)
             }
             setStringScriptVariable("checkValidRecord", "false")
             return
     
       }
     
        //ACCOUNT MAIN PERSON MARRIAGE/DIVORCE/SEPARATION CHECK end
     }
