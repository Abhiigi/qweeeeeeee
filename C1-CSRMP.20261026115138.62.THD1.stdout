@groovy.transform.CompileStatic
 class CMDbtMrgRMEC extends com.splwg.base.api.serviceScript.GenericGroovyObject {
    private static final com.splwg.shared.logging.Logger logger = com.splwg.shared.logging.LoggerFactory.getLogger("ugbu.groovy.CMDbtMrgRMEC") 
    // --  members from step 30 
     void getMarriageDate(){
     
             StringBuilder builder = new StringBuilder();
     
             builder.append("SELECT CHR.EFFDT ");
             builder.append("FROM CI_ACCT_PER ACP, CI_PER_CHAR CHR ");
             builder.append("WHERE ACP.ACCT_ID = :acctId ");
       		builder.append("AND ACP.MAIN_CUST_SW ='Y' ");
             builder.append("AND ACP.FIN_RESP_SW = 'Y' ");
             builder.append("AND ACP.PER_ID = CHR.PER_ID ");
             builder.append("AND CHR.CHAR_TYPE_CD = 'CM_MRLST' ");
             builder.append("AND CHR.CHAR_VAL = 'MARRIED' ");
             builder.append("ORDER BY CHR.EFFDT DESC");
     
             PreparedStatementQuery psQuery = createPreparedStatement(new StringBuffer(" ").append(builder.toString()).toString(),"getMarriageDate");
     
               psQuery.bindString("acctId", evalString('$accountId'), "ACCT_ID");
     
             SQLResultRow result = psQuery.firstRow();
     
             if (!isNull(result)){
               String MarriageDate = result.getDate("EFFDT").toString();
               setStringScriptVariable('marriageDate', MarriageDate);
     
             }
               else {
               setStringScriptVariable('marriageDate', null);
     
           }
     
         }
   // --  end members from step 30 


   // --  members from step 40 
     void getDivorceDate() {
     
             StringBuilder builder = new StringBuilder();
     
             builder.append("SELECT CHR.EFFDT ");
             builder.append("FROM CI_ACCT_PER ACP, CI_PER_CHAR CHR ");
             builder.append("WHERE ACP.ACCT_ID = :acctId ");
       		builder.append("AND ACP.MAIN_CUST_SW ='Y' ");
             builder.append("AND ACP.FIN_RESP_SW = 'Y' ");
             builder.append("AND ACP.PER_ID = CHR.PER_ID ");
             builder.append("AND CHR.CHAR_TYPE_CD = 'CM_MRLST' ");
             builder.append("AND (CHR.CHAR_VAL = 'DIVORCED' OR CHR.CHAR_VAL = 'SEPARATED') ");
             builder.append("ORDER BY CHR.EFFDT DESC");
     
             PreparedStatementQuery psQuery = createPreparedStatement(new StringBuffer(" ").append(builder.toString()).toString(),"getDivorceDate");
     
               psQuery.bindString("acctId", evalString('$accountId'), "ACCT_ID")
     
             SQLResultRow result = psQuery.firstRow();
     
             if (!isNull(result)) {
                 String divorceDate = result.getDate("EFFDT").toString();
                   setStringScriptVariable('divorceDate', divorceDate);
     
             }
               else{
                 setStringScriptVariable('divorceDate', null);
             }
     
             //return null;
         }
   // --  end members from step 40 



}
