     	            """, 'getWOP ID');
     
     
       	query.bindString("saId", vSaId, 'SA_ID');
     
       	SQLResultRow result = query.firstRow();
     
       	if (!isNull(result)){
           String wopId = result.getString('WO_PROC_ID');
      	  setStringScriptVariable('vWopId', wopId);
         }
     }
