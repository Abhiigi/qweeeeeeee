     move 'CM-SETPAYARR' to $algorithmType;
     move null to "C1-RetrieveAlgoTypeParmLabel";
     move "$algorithmType" to "C1-RetrieveAlgoTypeParmLabel/input/algorithmType";
     invokeBS 'C1-RetrieveAlgoTypeParmLabel' using "C1-RetrieveAlgoTypeParmLabel";
     //No Transfer Char Type validation
     move "C1-RetrieveAlgoTypeParmLabel/output/algorithmTypeParameters[sequence=250]/label" to $parm25Desc;
     move null to "F1-DoesEntityExist";
     move "$spNoTransferCharType" to "F1-DoesEntityExist/pkValue1";
     move 'CHAR TYPE' to "F1-DoesEntityExist/mo";
     invokeBS 'F1-DoesEntityExist' using "F1-DoesEntityExist";
     if ("string(F1-DoesEntityExist/entityExists) = 'false'")
          terminate with error (90003, 1 %1="$parm25Desc" %2="$spNoTransferCharType" %3='value');
     end-if;
     //Adjustment Type for Misc Cuttable
     move "C1-RetrieveAlgoTypeParmLabel/output/algorithmTypeParameters[sequence=210]/label" to $parm21Desc;
     move null to "C1-Tokenize";
     move "$spAdjTypeForMiscCuttable" to "C1-Tokenize/input/string";
     move ',' to "C1-Tokenize/input/delimiter";
     invokeSS 'C1-Tokenize' using "C1-Tokenize";
     for ($resultList in "C1-Tokenize/output/constantList")
          move null to "F1-DoesEntityExist";
          move "normalize-space($resultList/constantValue)" to "F1-DoesEntityExist/pkValue1";
          move 'ADJ TYPE' to "F1-DoesEntityExist/mo";
          invokeBS 'F1-DoesEntityExist' using "F1-DoesEntityExist";
          if ("string(F1-DoesEntityExist/entityExists) = 'false'")
               terminate with error (90003, 1 %1="$parm21Desc" %2="normalize-space($resultList/constantValue)" %3='value');
          end-if;
     end-for;
     //Adjustment Type for Misc Non Cuttable
     move "C1-RetrieveAlgoTypeParmLabel/output/algorithmTypeParameters[sequence=220]/label" to $parm22Desc;
     move null to "C1-Tokenize";
     move "$spAdjTypeForMiscNonCuttable" to "C1-Tokenize/input/string";
     move ',' to "C1-Tokenize/input/delimiter";
     invokeSS 'C1-Tokenize' using "C1-Tokenize";
     for ($resultList in "C1-Tokenize/output/constantList")
          move null to "F1-DoesEntityExist";
          move "normalize-space($resultList/constantValue)" to "F1-DoesEntityExist/pkValue1";
          move 'ADJ TYPE' to "F1-DoesEntityExist/mo";
          invokeBS 'F1-DoesEntityExist' using "F1-DoesEntityExist";
          if ("string(F1-DoesEntityExist/entityExists) = 'false'")
               terminate with error (90003, 1 %1="$parm22Desc" %2="normalize-space($resultList/constantValue)" %3='value');
          end-if;
     end-for;
     //Electric Adj Types
     move "C1-RetrieveAlgoTypeParmLabel/output/algorithmTypeParameters[sequence=300]/label" to $parm30Desc;
     move null to "C1-Tokenize";
     move "$electricAdjTypes" to "C1-Tokenize/input/string";
     move ',' to "C1-Tokenize/input/delimiter";
     invokeSS 'C1-Tokenize' using "C1-Tokenize";
     for ($resultList in "C1-Tokenize/output/constantList")
          move null to "F1-DoesEntityExist";
          move "normalize-space($resultList/constantValue)" to "F1-DoesEntityExist/pkValue1";
          move 'ADJ TYPE' to "F1-DoesEntityExist/mo";
          invokeBS 'F1-DoesEntityExist' using "F1-DoesEntityExist";
          if ("string(F1-DoesEntityExist/entityExists) = 'false'")
               terminate with error (90003, 1 %1="$parm30Desc" %2="normalize-space($resultList/constantValue)" %3='value');
          end-if;
     end-for;
     //GAS Adj Types
