package c1; 

import com.splwg.ccb.domain.customerServiceRequestManagement.customerServiceRequest.entity.CustomerServiceRequest
import com.splwg.base.api.sql.PreparedStatementQuery
import com.splwg.base.api.sql.SQLResultRow
//Generated source for script:C1CSReqSSTC-1
@groovy.transform.CompileStatic
 class C1CSReqSSTC_Impl extends com.splwg.base.api.serviceScript.GenericGroovyObject 
implements c1.C1CSReqSSTC
 {
    private static final com.splwg.shared.logging.Logger logger = com.splwg.shared.logging.LoggerFactory.getLogger("ugbu.groovy.C1CSReqSSTC_Impl") 
    // --  members from step 20 
     boolean isCSRequestNonFinal(CustomerServiceRequest csRequest) {
         PreparedStatementQuery query = createPreparedStatement("""
               SELECT
                   'X'
               FROM
                   C1_CS_REQ CSREQ,
                   F1_BUS_OBJ BO,
                   F1_BUS_OBJ_STATUS BOSTATUS
               WHERE
                   CSREQ.CS_REQ_ID = :csReqId
                   AND CSREQ.BUS_OBJ_CD = BO.BUS_OBJ_CD
                   AND CSREQ.BUS_OBJ_CD = BOSTATUS.BUS_OBJ_CD
                   AND BOSTATUS.BUS_OBJ_CD = BO.LIFE_CYCLE_BO_CD
                   AND CSREQ.BO_STATUS_CD = BOSTATUS.BO_STATUS_CD
                   AND BOSTATUS.BO_STATUS_COND_FLG <> 'F1FL'
             """, 'Retrieve non-final CS Request')
     
     	query.bindEntity("csReqId", csRequest);
     
     	SQLResultRow row = query.firstRow();
     	if (!isNull(row)) return true;
     }
   // --  end members from step 20 


   // --  members from step 30 
     void validateParentCSRequestErrorHandling(CustomerServiceRequest parentCSRequest) {
     	if (parentCSRequest.getCsRequestErrorHandling().isUseParentCSReqFlag()) {
     		addError(11131,11104,parentCSRequest.getCsRequestErrorHandling().getLookupValue().fetchLanguageDescription(), parentCSRequest.getId().getTrimmedValue());
         }
     }
   // --  end members from step 30 



}
