10:51:41,806 [DEFAULTWorker:5] INFO  (com.splwg.base.support.scripting.actions.Action) Executing script 'C1PROPREUPDT' : Executing step:  30: groovy members
          void retrieveLastCSRequestPremiseException() {
              PreparedStatementQuery query = createPreparedStatement("""
                  SELECT
                      A.SEQNO,
                      A.LOG_DTTM
                  FROM
                      C1_CS_REQ_PREM_LOG A
                  WHERE
                      A.CS_REQ_PREM_ID = :custSvcReqPremiseId
                      AND A.LOG_ENTRY_TYPE_FLG = 'F1EX'
                  ORDER BY A.LOG_DTTM DESC
              """,'Get CS Request Premise Last Error')
     
              query.bindEntity("custSvcReqPremiseId",new CustomerServiceRequestPremise_Id(getStringScriptVariable('custSvcReqPremiseId')).getEntity());
              SQLResultRow result = query.firstRow();
              String seqNumber = result.getString("SEQNO");
              setStringScriptVariable 'seqNumber', seqNumber;
          }
end-groovy-members;
