            	String bo = evalString('parm/hard/businessObject/id');
          	declareBO bo, "bo_schema";
          	move csReqAcctId, "bo_schema/custSvcReqAccountId";
          	invokeBO ccbBOAction.constants.READ, bo, "bo_schema";
     
          	boolean shouldSkipTransition = evalBoolean('bo_schema/shouldSkipTransitionToAddUpdate');
          	// If set to true, stay on the current status. This means that the Add/Update action has already been performed.
           	if (shouldSkipTransition) {
          		move shouldSkipTransition, "parm/hard/skipAutoTransitioning";
          		// Reset the shouldSkipTransition, Add/Update has already been performed.
          		move false, "bo_schema/shouldSkipTransitionToAddUpdate";
          		invokeBO ccbBOAction.constants.UPDATE, bo, "bo_schema";
          		return;
              }
          	// Transition to Add/Update Status
          	move 'C1TU', "parm/hard/nextStatusCondition";
     
          }
end-groovy-members;
