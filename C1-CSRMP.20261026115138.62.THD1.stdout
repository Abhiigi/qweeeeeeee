          move "$id" to "F1-DetermineBo/input/pkValue1";
          invokeBS 'F1-DetermineBo' using "F1-DetermineBo";
          // Read child CS request
          declareBO "F1-DetermineBo/output/bo" as 'bo_schema';
          move "$id" to "bo_schema/custSvcReqPersonId";
          invokeBO "F1-DetermineBo/output/bo" using "bo_schema" for read;
          // If child CS request is in errror, discard.  Otherwise, transition to default next state
          if ("string(bo_schema/boStatus) = 'ERROR' or xs:boolean($isProcessFlowCanceled)")
               // Determine discard status
               move "F1-DetermineBo/output/bo" to "F1-RetTrnNSt/input/bo";
               move "bo_schema/boStatus" to "F1-RetTrnNSt/input/boStatus";
               move "$id" to "F1-RetTrnNSt/input/pkValue1";
               move 'C1AD' to "F1-RetTrnNSt/input/boTransitionCondition";
               invokeSS 'F1-RetTrnNSt' using "F1-RetTrnNSt";
               move "string(F1-RetTrnNSt/output/boStatus)" to "bo_schema/boStatus";
               invokeBO "F1-DetermineBo/output/bo" using "bo_schema" for fastUpdate;
          else
               move "$mo" to "F1-AutoTransitionBO/mo";
               move "$id" to "F1-AutoTransitionBO/primeKeyValues/pkValue1";
               invokeBS 'F1-AutoTransitionBO' using "F1-AutoTransitionBO";
               move "bo_schema/bo" to "F1-BusinessObject/bo";
               invokeBO 'F1-BusinessObject' using "F1-BusinessObject" for read;
               declareBO 'F1-BusinessObject' as 'lifecycle_bo_schema';
               move "F1-BusinessObject/lifeCycleBo" to "lifecycle_bo_schema/bo";
               invokeBO 'F1-BusinessObject' using "lifecycle_bo_schema" for read;
               move "string(F1-AutoTransitionBO/finalStatus)" to $csrChildStatus;
               move "lifecycle_bo_schema/lifecycleInformation[status = $csrChildStatus]/statusCondition" to $boStatusCondition;
               if ("string($boStatusCondition) != 'F1FL'")
                    terminate with error (11131, 11611 %1="$id");
               end-if;
          end-if;
     end-for;
end-edit;
