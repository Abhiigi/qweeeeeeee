   // --  members from step 300 
     public void convertToTitleCase() {
         List<String> doubleDirections = new ArrayList<String>();
         doubleDirections.add("NW");
         doubleDirections.add("NE");
         doubleDirections.add("SW");
         doubleDirections.add("SE");
         String input = evalString('$inputString');
     
         String[] arr = input.split(" ");
     
         StringBuilder titleCase = new StringBuilder();
         boolean firstWord = true;
         for (String s : arr) {
             // Append space for subsequent words
             if (!firstWord) {
                 titleCase.append(" ");
             }
     
             if (!doubleDirections.contains(s))
                 if (s.length() > 1) titleCase.append(s.substring(0, 1).toUpperCase() + s.substring(1).toLowerCase());
                 else titleCase.append(s.substring(0, 1).toUpperCase());
             else
                 titleCase.append(s);
             firstWord = false;
     
         }
         setStringScriptVariable('outputString', titleCase.toString());
     }
   // --  end members from step 300 


