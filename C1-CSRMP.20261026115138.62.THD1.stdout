   // --  members from step 510 
     List<SQLResultRow> getTransferAdjustmentDetails(String saId) {
     
         StringBuilder builder = new StringBuilder();
     
         builder.append("SELECT ORIG.ADJ_AMT, ");
         builder.append("XFER.SA_ID AS XFER_SA_ID, ");
         builder.append("ORIG.SA_ID AS ORIG_SA_ID ");
         builder.append("FROM CI_ADJ ORIG, CI_ADJ XFER ");
         builder.append("WHERE ORIG.SA_ID = :saId ");
         builder.append("AND XFER.ADJ_ID = ORIG.XFER_ADJ_ID ");
     
         PreparedStatementQuery psQuery = createPreparedStatement(
             new StringBuffer(" ").append(builder.toString()).toString(),
             "getTransferAdjustmentDetails"
         );
     
         psQuery.bindString(
             "saId",
             saId,
             "SA_ID"
         );
     
         List<SQLResultRow> queryResults = psQuery.list();
     
         psQuery.close();
     
         return queryResults;
     }
   // --  end members from step 510 


   // --  members from step 520 
     List<SQLResultRow> getDebtTransferAdjustmentDetails(String saId) {
     
         StringBuilder builder = new StringBuilder();
     
         builder.append("SELECT ORIG.ADJ_AMT, ");
         builder.append("       XFER.SA_ID AS XFER_SA_ID, ");
         builder.append("       ORIG.SA_ID AS ORIG_SA_ID, ");
         builder.append("       SATYP.DEBT_CL_CD ");
         builder.append("FROM CI_ADJ ORIG, ");
         builder.append("     CI_ADJ XFER, ");
         builder.append("     CI_SA SA, ");
         builder.append("     CI_SA_TYPE SATYP ");
         builder.append("WHERE ORIG.SA_ID = :saId ");
         builder.append("AND XFER.ADJ_ID = ORIG.XFER_ADJ_ID ");
         builder.append("AND SA.SA_ID = XFER.SA_ID ");
         builder.append("AND SATYP.SA_TYPE_CD = SA.SA_TYPE_CD ");
         builder.append("AND SATYP.CIS_DIVISION = SA.CIS_DIVISION ");
     
         PreparedStatementQuery psQuery = createPreparedStatement(
             new StringBuffer(" ").append(builder.toString()).toString(),
             "getDebtTransferAdjustmentDetails"
         );
     
         psQuery.bindString(
             "saId",
             saId,
             "SA_ID"
         );
     
         List<SQLResultRow> queryResults = psQuery.list();
     
         psQuery.close();
     
         return queryResults;
     }
   // --  end members from step 520 



