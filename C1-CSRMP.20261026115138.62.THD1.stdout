     invokeSS 'C1GetChldCSR' using "C1GetChldCSR";
     for ($childCSRequest in "C1GetChldCSR/output/custSvcReqPerson")
          move "$childCSRequest/custSvcReqPersonId" to $id;
          // Determine child CS request BO
          move null to "F1-DetermineBo";
