   // --  members from step 450 
     public boolean isSAHasLandlordAgreement(ServiceAgreement serviceAgreement) {
     
     	StringBuilder builder = new StringBuilder();
     	builder.append("SELECT PREM.LL_ID ");
     	builder.append("FROM CI_SA_SP SASP, CI_SP SP, CI_PREM PREM ");
     	builder.append("WHERE SASP.SA_ID = :serviceAgreement ");
     	builder.append("AND SASP.SP_ID = SP.SP_ID ");
     	builder.append("AND SP.PREM_ID = PREM.PREM_ID ");
     
     	PreparedStatementQuery psQuery = createPreparedStatement(new StringBuffer(" ").append(builder.toString()).toString(), "isSAHasLandlordAgreement");
     	psQuery.bindId("serviceAgreement", serviceAgreement.getId() );
     
     	List<SQLResultRow> queryResults = psQuery.list();
       	psQuery.close();
       if (queryResults == null || queryResults.isEmpty()) {
     return false;
     }
     
     	for (queryResult in queryResults) {
     		if(isEmptyOrNull(queryResult.getString('LL_ID').trim())) {
             	return false;
             }
       	}
     	return true;
     
     }
