10:51:39,857 [DEFAULTWorker:5] INFO  (com.splwg.base.support.scripting.actions.Action) Executing script 'C1FINCHLDCSR' : Executing step:  50: edit data
     declareBO "parm/hard/businessObject/id" as 'csreqbo_schema';
     move "parm/hard/businessObjectKey" to "csreqbo_schema";
     invokeBO "parm/hard/businessObject/id" using "csreqbo_schema" for read;
     // This plug-in script is used in:
     // 1) Cancel and Complete status of the Start Service and Stop Service Request BOs
     // 2) Cancel status of the Transfer Service Request BO
     // If we are cancelling the request, then check first if all SAs were already cancelled. If not, throw an error.
     if ("string(csreqbo_schema/boStatus) = 'CANCELED'")
          invokeGroovy 'checkAllSAsCancelled';
     end-if;
     // Retrieve child CS request SA
     move 'C1-CSREQSA' to $mo;
     move null to "C1GetChldCSR";
     move "parm/hard/businessObjectKey/customerServiceRequestId" to "C1GetChldCSR/input/customerServiceRequestId";
     move "$mo" to "C1GetChldCSR/input/mo";
     invokeSS 'C1GetChldCSR' using "C1GetChldCSR";
     for ($childCSRequest in "C1GetChldCSR/output/custSvcReqSA")
          move "$childCSRequest/custSvcReqSAId" to $id;
          // Determine child CS request BO
          move null to "F1-DetermineBo";
          move "$mo" to "F1-DetermineBo/input/mo";
          move "$id" to "F1-DetermineBo/input/pkValue1";
          invokeBS 'F1-DetermineBo' using "F1-DetermineBo";
          // Read child CS request
          declareBO "F1-DetermineBo/output/bo" as 'bo_schema';
          move "$id" to "bo_schema/custSvcReqSAId";
          invokeBO "F1-DetermineBo/output/bo" using "bo_schema" for read;
          // If child CS request is pending, discard.  Otherwise, transition to default next state
          if ("string(bo_schema/boStatus) = 'PENDING'")
               // Determine discard status
               move "F1-DetermineBo/output/bo" to "F1-RetTrnNSt/input/bo";
               move "bo_schema/boStatus" to "F1-RetTrnNSt/input/boStatus";
               move "$id" to "F1-RetTrnNSt/input/pkValue1";
               move 'C1AD' to "F1-RetTrnNSt/input/boTransitionCondition";
               invokeSS 'F1-RetTrnNSt' using "F1-RetTrnNSt";
               // Update child CS request
               move "string(F1-RetTrnNSt/output/boStatus)" to "bo_schema/boStatus";
               invokeBO "F1-DetermineBo/output/bo" using "bo_schema" for fastUpdate;
          end-if;
     end-for;
end-edit;
