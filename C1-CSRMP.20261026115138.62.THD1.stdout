          void invoke() {
          	String csReqPerId = evalString('parm/hard/businessObjectKey/custSvcReqPersonId');
          	CustomerServiceRequestPerson csRequestPerson = new CustomerServiceRequestPerson_Id(csReqPerId).getEntity();
          	// If no CS Request Person, skip further processing
          	if (isNull(csRequestPerson)) return;
          	// If parent CS Request is already in final state, transition to the next default status "Complete"
          	C1CSReqSSTC instance = createLibraryScript(C1CSReqSSTC.class);
          	if (!instance.isCSRequestNonFinal(csRequestPerson.getCustomerServiceRequest())) {
          		move true, "parm/hard/useDefaultNextStatus";
          		return;
          	}
     
            	String bo = evalString('parm/hard/businessObject/id');
          	declareBO bo, "bo_schema";
          	move csReqPerId, "bo_schema/custSvcReqPersonId";
          	invokeBO ccbBOAction.constants.READ, bo, "bo_schema";
     
          	boolean shouldSkipTransition = evalBoolean('bo_schema/shouldSkipTransitionToAddUpdate');
          	// If set to true, stay on the current status. This means that the Add/Update action has already been performed.
           	if (shouldSkipTransition) {
          		move shouldSkipTransition, "parm/hard/skipAutoTransitioning";
          		// Reset the shouldSkipTransition, so the next time the monitor is called and the Add/Update action is not yet
          		// performed, then transition to the Add/Update status
          		move false, "bo_schema/shouldSkipTransitionToAddUpdate";
          		invokeBO ccbBOAction.constants.UPDATE, bo, "bo_schema";
          		return;
              }
     
          	boolean isReadyToComplete = evalBoolean('bo_schema/isReadyToComplete');
              if (isReadyToComplete) {
                  move true, "parm/hard/skipAutoTransitioning";
              } else {
          	    // Transition to Add/Update Status
          	    move 'C1UA', "parm/hard/nextStatusCondition";
              }
          }
end-groovy-members;
