     public void getClosedCollectionAgencyReferral() {
     
     	String account = evalString('$accountId');
     
     	PreparedStatementQuery query = createPreparedStatement("""
     														SELECT A.COLL_AGY_REF_ID AS COLLECTION,
     															A.SEQ_NUM AS SEQ
     														FROM CI_COLL_AGY_HIS A,
     															CI_COLL_AGY_REF B
     														WHERE A.COLL_AGY_REF_ID = B.COLL_AGY_REF_ID
     															AND B.ACCT_ID IN
     															(SELECT ACPER.ACCT_ID
     																	FROM
     																	(SELECT ACP.PER_ID
     																		FROM
     																		CI_ACCT_PER ACP
                                                                				WHERE
     																		ACP.ACCT_ID = :accountId) TEMP,
     														CI_ACCT_PER ACPER
     														WHERE ACPER.PER_ID = TEMP.PER_ID)
     														AND B.REF_STATUS_FLG = 'C'
     														AND A.REF_HIST_RSN_FLG = 'PAID'
                                                             AND A.REF_AMT = 0
     														AND A.CRE_DT = :processDate
     														""", 'Get Collection Agencies Referral');
     
     
     	query.bindString("accountId", account, 'ACCT_ID');
     	query.bindDate("processDate", getProcessDateTime().getDate());
     
     	List<SQLResultRow> results = query.list();
     
     	//Close the query
     	query.close();
     
     	if (!isNull(results)){
     
     		for (SQLResultRow result: results) {
     			String col = result.getString('COLLECTION');
     			String seq = result.getString('SEQ');
     			updateCollectionAgencyReferralHist(col,seq);
     		}
     	}
     
     }
   // --  end members from step 270 


   // --  members from step 280 
     private void updateCollectionAgencyReferralHist(String collection, String seq) {
     	BigInteger collAgyHistSeq = new BigInteger(seq);
     	CollectionAgencyReferral collAgyRef = new CollectionAgencyReferral_Id(collection).getEntity();
     	CollectionAgencyHistory_Id collectionAgencyHistoryID = new CollectionAgencyHistory_Id(collAgyRef, collAgyHistSeq);
     	CollectionAgencyHistory_DTO collectionAgencyHistoryDTO = collectionAgencyHistoryID.getEntity().getDTO();
     	collectionAgencyHistoryDTO.setReferralHistoryReason(LookupHelper.getLookupInstance(ReferralHistoryReasonLookup.class, evalString('$refHistReason')));
     	collectionAgencyHistoryID.getEntity().setDTO(collectionAgencyHistoryDTO);
     }
   // --  end members from step 280 


   // --  members from step 290 
     public void getLatestActiveAgencyReferral() {
     
     	String account = evalString('$agencyAccountId');
     
     	PreparedStatementQuery query = createPreparedStatement("""
     														SELECT A.COLL_AGY_REF_ID AS COLLECTION
     														FROM CI_COLL_AGY_REF A
     														WHERE A.ACCT_ID = :accountId
     														AND A.REF_STATUS_FLG = 'A'
                                                             ORDER BY A.START_DT DESC
     														""", 'Retrieve recent active Agency Referral given Account Id');
     
     
     	query.bindString("accountId", account, 'ACCT_ID');
     
     	SQLResultRow result = query.firstRow();
     
     	//Close the query
     	query.close();
     
     	if (!isNull(result)){
     
     	    String col = result.getString('COLLECTION');
             setStringScriptVariable('agencyAccountReferralId', col);
     
     	}
     
     }
