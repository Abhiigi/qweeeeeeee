10:51:42,058 [DEFAULTWorker:5] INFO  (com.splwg.base.support.scripting.actions.Action) Executing script 'C1FINCHLDCSR' : Executing step:  60: groovy members
          void checkAllSAsCancelled() {
          	CustomerServiceRequest csRequest = new CustomerServiceRequest_Id(evalString('parm/hard/businessObjectKey/customerServiceRequestId')).getEntity();
              CustomerServiceRequestType csReqType = csRequest.getCustomerServiceRequestType();
              CsRequestTransactionTypeLookup transType = csReqType.getCsRequestTransactionType();
              BusinessObject saBo;
          	ServiceAgreementStatusLookup saStatus1;
            	ServiceAgreementStatusLookup saStatus2;
     
              if (transType == CsRequestTransactionTypeLookup.constants.START_SERVICE) {
                  saBo  = csReqType.fetchCustomerServiceRequestSaBO();
                  saStatus1 = ServiceAgreementStatusLookup.constants.CANCELED;
                  saStatus2 = ServiceAgreementStatusLookup.constants.CANCELED;
              } else if (transType == CsRequestTransactionTypeLookup.constants.STOP_SERVICE) {
                  saBo  = csReqType.fetchCustomerServiceRequestSa2BO();
                  saStatus1 = ServiceAgreementStatusLookup.constants.CANCELED;
                  saStatus2 = ServiceAgreementStatusLookup.constants.ACTIVE;
              }
     
             	PreparedStatementQuery query = createPreparedStatement("""
          			SELECT 'X'
          			FROM
          				C1_CS_REQ_SA CSRSA,
          				CI_SA SA
          			WHERE
          				CSRSA.CS_REQ_ID = :csReqId
          				AND CSRSA.BUS_OBJ_CD = :busObject
          				AND CSRSA.SA_ID = SA.SA_ID
          				HAVING COUNT(SA.SA_ID) = (SELECT COUNT(SA2.SA_ID)
          										FROM
          											C1_CS_REQ_SA CSRSA2,
          											CI_SA SA2
          										WHERE
          											CSRSA2.CS_REQ_ID = :csReqId
          											AND CSRSA2.SA_ID = SA2.SA_ID
          											AND CSRSA2.BUS_OBJ_CD = :busObject
          											AND SA2.SA_STATUS_FLG IN (:status1, :status2))
              		""", 'Check SAs statuses')
     
          		query.bindEntity("csReqId", csRequest);
                  query.bindEntity("busObject", saBo);
                  query.bindLookup("status1", saStatus1);
                  query.bindLookup("status2", saStatus2);
          		SQLResultRow result = query.firstRow();
     
            		if (isNull(result)) {
          		    if (transType == CsRequestTransactionTypeLookup.constants.START_SERVICE) {
                       addError(11131,11621);
          	        } else if (transType == CsRequestTransactionTypeLookup.constants.STOP_SERVICE) {
                    	 addError(11131,11622);
          			}
                  }
          }
end-groovy-members;
