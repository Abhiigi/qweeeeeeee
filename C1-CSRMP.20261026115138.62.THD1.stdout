     if ("string($debtAge) = 'Y'")
          //ADO - 1146640 related changes start
          //Arrears Date
          invokeGroovy 'getWOPId';
          //terminate with error(90001,7 %1 ="string($transferFromSa)") ;
          //terminate with error(90001,7 %1 ="string($vWopId)") ;
          //terminate with error(90001,7 %1 ='WOPID=' %2 ="$vWopId");
          //1279518 - WO SA related changes. start
          if ("xs:string($vWopId) = $BLANK")
               //terminate with error(90001,7 %1 ='Wo process SA logic 123') ;
               invokeGroovy 'stdSAProc';
               invokeGroovy 'taxSAProc';
               invokeGroovy 'nonStdSAProc';
               goto processNextSa;
          end-if;
          //1279518 - WO SA related changes. end
          move "string($vWopId)" to "C1WriteOffProcessRead/writeOffProcess";
          invokeBS 'C1WriteOffProcessRead' using "C1WriteOffProcessRead";
          move "C1WriteOffProcessRead/sa[serviceAgreement = $transferFromSa]/saArrears[last()]/daysAge" to $debtAgeD;
          move null to "F1-DateMath";
          move "$PROCESS-DATE" to "F1-DateMath/beginDate";
          move 'F1AD' to "F1-DateMath/option";
          move "xs:integer($debtAgeD) * (-1)" to "F1-DateMath/days";
          move 'MECW01' to "F1-DateMath/calendar";
          invokeBS 'F1-DateMath' using "F1-DateMath";
          move "F1-DateMath/endDate" to $vArrearsDate;
          //ADO - 1146640 related changes End
          // move "$endDate" to $arrearsDate;
          move "$vArrearsDate" to $arrearsDate;
     else
          // Else if Debt Age = N, Arears Date is Process Date
          move "$PROCESS-DATE" to $arrearsDate;
     end-if;
     invokeGroovy 'createFrozenTransferAdjustment';
     //ADO - 1146640 related changes Start
     move null to "C1AdjustmentRead";
     move "$adjustmentId" to "C1AdjustmentRead/adjustmentId";
     invokeBS 'C1AdjustmentRead' using "C1AdjustmentRead";
     move "C1AdjustmentRead/transferAdjustmentId" to $transferAdjustmentId;
     move "xs:string(C1AdjustmentRead/accountingDate)" to $accountingDate;
     move "substring($accountingDate,3,2)" to $year;
     move "substring($accountingDate, 6, 2)" to $month;
     move "concat($month, '/', $year)" to $calAccountingDate;
     move "C1AdjustmentRead/currentAmount" to $adjcurrentAmount;
     move "concat($calAccountingDate,' Trf from &quot;',$fromSaPremiseAddress,'&quot; ',$adjcurrentAmount)" to $adjComments;
     move null to "C1AdjustmentUpdate";
     move "$adjustmentId" to "C1AdjustmentUpdate/adjustmentId";
     move "$adjComments" to "C1AdjustmentUpdate/comments";
     invokeBS 'C1AdjustmentUpdate' using "C1AdjustmentUpdate";
     move null to "C1AdjustmentRead";
     move "$transferAdjustmentId" to "C1AdjustmentRead/adjustmentId";
     invokeBS 'C1AdjustmentRead' using "C1AdjustmentRead";
     move "xs:string(C1AdjustmentRead/accountingDate)" to $trfAccountingDate;
     move "substring($trfAccountingDate,3,2)" to $year;
     move "substring($trfAccountingDate, 6, 2)" to $month;
     move "concat($month, '/', $year)" to $TrfCalAccountingDate;
     move "C1AdjustmentRead/currentAmount" to $trfAdjcurrentAmount;
     move "concat($TrfCalAccountingDate,' Trf to &quot;',$toSaPremiseAddress,'&quot; ',$trfAdjcurrentAmount)" to $trfAdjComments;
     move null to "C1AdjustmentUpdate";
     move "$transferAdjustmentId" to "C1AdjustmentUpdate/adjustmentId";
     move "$trfAdjComments" to "C1AdjustmentUpdate/comments";
     invokeBS 'C1AdjustmentUpdate' using "C1AdjustmentUpdate";
     //ADO - 1146640 related changes End
     //Sushnat Start
     if ("string($adjustmentId) != $BLANK")
          if ("string($comboChecking) = 'true'")
               invokeGroovy 'cuttableSAProc';
               invokeGroovy 'nonCuttableSAProc';
          end-if;
          //New 10/7 start
          //terminate with error(90001,7 %1 ="xs:string($revenueClass)" %2="xs:string($transferFromSa)") ;
          //invokeGroovy 'stdSAProc';
          //invokeGroovy 'taxSAProc';
          //invokeGroovy 'nonStdSAProc';
          //New 10/7 end
     end-if;
     //Sushant End
     // Add To Address Adjustment Char
     move null to "F1-CharTypePhysicalBO";
     move "$toAddressCharType" to "F1-CharTypePhysicalBO/characteristicType";
     invokeBO 'F1-CharTypePhysicalBO' using "F1-CharTypePhysicalBO" for read;
     move "F1-CharTypePhysicalBO/characteristicTypeFlag" to $charTypeFlg;
     move null to "F1-CharTypePhysicalBO";
     move null to "C1AdjustmentUpdate";
     move "$adjustmentId" to "C1AdjustmentUpdate/adjustmentId";
     move '1' to "C1AdjustmentUpdate/+adjChar/sequence2";
     move "$toAddressCharType" to "C1AdjustmentUpdate/adjChar[last()]/characteristicType2";
     if ("string($charTypeFlg) = 'DFV'")
          move "$toSaPremiseAddress" to "C1AdjustmentUpdate/adjChar[last()]/characteristicValue2";
     end-if;
     if ("string($charTypeFlg) = 'FKV'")
          move "$toSaPremiseAddress" to "C1AdjustmentUpdate/adjChar[last()]/characteristicValueForeignKey1";
     end-if;
     if ("string($charTypeFlg) = 'ADV' or string($charTypeFlg) = 'FLV'")
          move "$toSaPremiseAddress" to "C1AdjustmentUpdate/adjChar[last()]/adhocCharacteristicValue";
     end-if;
     invokeBS 'C1AdjustmentUpdate' using "C1AdjustmentUpdate";
     move null to "C1AdjustmentUpdate";
     // Add From Address Adjustment Char
     move "$fromAddressCharType" to "F1-CharTypePhysicalBO/characteristicType";
     invokeBO 'F1-CharTypePhysicalBO' using "F1-CharTypePhysicalBO" for read;
     move "F1-CharTypePhysicalBO/characteristicTypeFlag" to $charTypeFlg;
     move null to "F1-CharTypePhysicalBO";
     // Get Transfer Adjustment ID
     move null to "C1AdjustmentRead";
     move "$adjustmentId" to "C1AdjustmentRead/adjustmentId";
     invokeBS 'C1AdjustmentRead' using "C1AdjustmentRead";
     move "C1AdjustmentRead/transferAdjustmentId" to $transferAdjustmentId;
     move "$transferAdjustmentId" to "C1AdjustmentUpdate/adjustmentId";
     move '2' to "C1AdjustmentUpdate/+adjChar/sequence2";
     move "$fromAddressCharType" to "C1AdjustmentUpdate/adjChar[last()]/characteristicType2";
     if ("string($charTypeFlg) = 'DFV'")
          move "$fromSaPremiseAddress" to "C1AdjustmentUpdate/adjChar[last()]/characteristicValue2";
     end-if;
     if ("string($charTypeFlg) = 'FKV'")
          move "$fromSaPremiseAddress" to "C1AdjustmentUpdate/adjChar[last()]/characteristicValueForeignKey1";
     end-if;
     if ("string($charTypeFlg) = 'ADV' or string($charTypeFlg) = 'FLV'")
          move "$fromSaPremiseAddress" to "C1AdjustmentUpdate/adjChar[last()]/adhocCharacteristicValue";
     end-if;
     invokeBS 'C1AdjustmentUpdate' using "C1AdjustmentUpdate";
     move null to "C1AdjustmentUpdate";
     //
     // Populate Customer Contact Data
     //
     // Populate SA ID, Account ID, Premise ID, and Premise Address of Account with Debt
     move "$transferFromSa" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/+sitesList/saId";
     move "$transferFromAccount" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/accountId";
     if ("string($fromSaPremiseId) != $BLANK")
          move "$fromSaPremiseId" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/premiseId";
     end-if;
     // Store Debt Recovery Previous Site Char to CC
     // Only Store Previous Side Char except for debtType = WOCONV and blank originSaId
     if ("not(string($saList/debtType) = 'WOCONV' and string($saList/originSaId) = $BLANK)")
          move "$fromSaPremiseAddress" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/premiseAddress";
     end-if;
     // Store Debt Recovery Effective Date, and Last Effective Date Chars to CC
     move "$transferFromAccount" to $currAccountId;
     move "string($startDate)" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/debtRecEffDate";
     move "string($endDate)" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/debtRecLstEffDate";
     // Store Debt Recovery Remaining Balance Char to CC
     move "$adjustmentAmount" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/debtRemBalance";
     // Legacy Account Char to CC
     move "$oldAccountId" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/legacyAccountId";
     // Store Revenue Class Char to CC
     move "$revenueClass" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/revClass";
     move null to "C1-RevenueClassPhysicalBO";
     if ("string($revenueClass) != $BLANK")
          move null to "C1-RevenueClassPhysicalBO";
          move "$revenueClass" to "C1-RevenueClassPhysicalBO/revenueClass";
          invokeBO 'C1-RevenueClassPhysicalBO' using "C1-RevenueClassPhysicalBO" for read;
          move "C1-RevenueClassPhysicalBO/description" to "CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[last()]/revClassDescription";
          move null to "C1-RevenueClassPhysicalBO";
     end-if;
     // Check if any of the From Premise Addresses are different. If yes, we use Multi-Site CC
     if ("string($fromSaPremiseAddress) != 'N/A' and count(CM-DebtRecoveryCCDetails/cmDebtRecoverySiteGroup/sitesList[premiseAddress!=$fromSaPremiseAddress]) >= 1")
          move 'true' to $multiSite;
     end-if;
end-if;
