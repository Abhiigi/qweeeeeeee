          void retrieveCSRequestPerson(){
              PreparedStatementQuery query = createPreparedStatement("""
                  SELECT CS_REQ_PER_ID, BUS_OBJ_CD, PER_ID
                  FROM C1_CS_REQ_PER
                  WHERE CS_REQ_ID = :custSvcReqId
              """, 'Retrieve CS Request Person');
              query.bindEntity("custSvcReqId", new CustomerServiceRequest_Id(evalString("parm/input/customerServiceRequestId")).getEntity());
              List<SQLResultRow> results = query.list();
              if (isNull(results)) {
                  logger.debug("Nothing found")
                  return;
              }
              for (result in results) {
                  move result.getString('CS_REQ_PER_ID'), "parm/output/+custSvcReqPerson/custSvcReqPersonId";
                  move result.getString('PER_ID'), "parm/output/custSvcReqPerson[last()]/personId";
                  move result.getString('BUS_OBJ_CD'), "parm/output/custSvcReqPerson[last()]/bo";
              }
          }
     
          void retrieveCSRequestAccount(){
              PreparedStatementQuery query = createPreparedStatement("""
                  SELECT CS_REQ_ACCT_ID, BUS_OBJ_CD, ACCT_ID
                  FROM C1_CS_REQ_ACCT
                  WHERE CS_REQ_ID = :custSvcReqId
              """, 'Retrieve CS Request Account');
              query.bindEntity("custSvcReqId", new CustomerServiceRequest_Id(evalString("parm/input/customerServiceRequestId")).getEntity());
              List<SQLResultRow> results = query.list();
              if (isNull(results)) {
                  logger.debug("Nothing found")
                  return;
              }
              for (result in results) {
                  move result.getString('CS_REQ_ACCT_ID'), "parm/output/+custSvcReqAccount/custSvcReqAccountId";
                  move result.getString('ACCT_ID'), "parm/output/custSvcReqAccount[last()]/accountId";
                  move result.getString('BUS_OBJ_CD'), "parm/output/custSvcReqAccount[last()]/bo";
              }
          }
     
          void retrieveCSRequestPremise(){
              PreparedStatementQuery query = createPreparedStatement("""
                  SELECT CS_REQ_PREM_ID, BUS_OBJ_CD, PREM_ID
                  FROM C1_CS_REQ_PREM
                  WHERE CS_REQ_ID = :custSvcReqId
              """, 'Retrieve CS Request Premise');
              query.bindEntity("custSvcReqId", new CustomerServiceRequest_Id(evalString("parm/input/customerServiceRequestId")).getEntity());
              List<SQLResultRow> results = query.list();
              if (isNull(results)) {
                  logger.debug("Nothing found")
                  return;
              }
              for (result in results) {
                  move result.getString('CS_REQ_PREM_ID'), "parm/output/+custSvcReqPremise/custSvcReqPremiseId";
                  move result.getString('PREM_ID'), "parm/output/custSvcReqPremise[last()]/premiseId";
                  move result.getString('BUS_OBJ_CD'), "parm/output/custSvcReqPremise[last()]/bo";
              }
          }
     
          void retrieveCSRequestSA() {
              CustomerServiceRequest csReq = new CustomerServiceRequest_Id(evalString("parm/input/customerServiceRequestId")).getEntity();
              CustomerServiceRequestType csReqType = csReq.getCustomerServiceRequestType();
              CsRequestTransactionTypeLookup transType = csReqType.getCsRequestTransactionType();
              BusinessObject saBo;
              BusinessObject sa2Bo;
              if (transType == CsRequestTransactionTypeLookup.constants.START_SERVICE) {
                  saBo  = csReqType.fetchCustomerServiceRequestSaBO();
                  sa2Bo = csReqType.fetchCustomerServiceRequestSaBO();
              } else if (transType == CsRequestTransactionTypeLookup.constants.STOP_SERVICE) {
                  saBo  = csReqType.fetchCustomerServiceRequestSa2BO();
                  sa2Bo = csReqType.fetchCustomerServiceRequestSa2BO();
              } else if (transType == CsRequestTransactionTypeLookup.constants.TRANSFER_SERVICE) {
                  saBo  = csReqType.fetchCustomerServiceRequestSaBO();
                  sa2Bo = csReqType.fetchCustomerServiceRequestSa2BO();
              }
     
              PreparedStatementQuery query = createPreparedStatement("""
                       SELECT CS_REQ_SA_ID, BUS_OBJ_CD
                       FROM C1_CS_REQ_SA
                       WHERE CS_REQ_ID = :custSvcReqId
                          AND BUS_OBJ_CD IN (:busObject, :busObject2)
                          """, 'Retrieve CS Request SA');
     
              query.bindEntity("custSvcReqId", csReq);
              query.bindEntity("busObject", saBo);
              query.bindEntity("busObject2", sa2Bo);
              List < SQLResultRow > results = query.list();
              if (isNull(results)) {
                  logger.debug("Nothing found")
                  return;
              }
              for (result in results) {
                  move result.getString('CS_REQ_SA_ID'), "parm/output/+custSvcReqSA/custSvcReqSAId";
                  move result.getString('BUS_OBJ_CD'), "parm/output/custSvcReqSA[last()]/bo";
              }
          }
