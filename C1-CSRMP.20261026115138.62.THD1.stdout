     void getAccountActiveServiceSA() {
       	String csrId = evalString('$csrId');
     
     	PreparedStatementQuery query = createPreparedStatement("""
     	         SELECT A.CS_REQ_SA_ID, B.SA_ID, C.REV_CL_CD
     	         FROM C1_CS_REQ_SA A, CI_SA B, CI_SA_TYPE C
     	         WHERE A.CS_REQ_ID = :custSvcReqId
     	            AND A.SA_ID = B.SA_ID
     				AND B.CIS_DIVISION = C.CIS_DIVISION
     				AND B.SA_TYPE_CD = C.SA_TYPE_CD
     				AND C.SPECIAL_ROLE_FLG NOT IN ('CD','LO','NB')
     				AND C.SVC_TYPE_CD <> 'M'
     	            """, 'Get Account Active Service SAs');
     
     
       	query.bindString("custSvcReqId", csrId, 'CS_REQ_ID');
     
       	List<SQLResultRow> results = query.list();
         List<String> activeSAs = new ArrayList<String>();
       	if (!isNull(results)){
             for (SQLResultRow result: results) {
                 String saId = result.getString('SA_ID');
      	        activeSAs.add(saId);
             }
