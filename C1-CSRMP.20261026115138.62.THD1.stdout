          move 'true' to $spouseExists;
     end-for;
     if ("string($spouseExists) != 'true'")
          move "$partialDebtPresent" to "parm/output/partialDebtPresent";
          terminate;
     end-if;
     if ("string($sPerId) != $BLANK")
          if ("string($sPerId) != string($csrPerId)")
               move "$partialDebtPresent" to "parm/output/partialDebtPresent";
               terminate;
          end-if;
     end-if;
     if ("string($spouseExists) = 'true'")
          invokeGroovy 'getMarriageDate';
          if ("string($marriageDate) != $BLANK")
               if ("xs:date($marriageDate) < xs:date($PROCESS-DATE)")
                    invokeGroovy 'getDivorceDate';
                    if ("string($divorceDate) != $BLANK")
                         if ("xs:date($divorceDate) <= xs:date($PROCESS-DATE)")
                              move "$divorceDate" to $divorceDate;
                         end-if;
                    else
                         move "xs:string($PROCESS-DATE)" to $divorceDate;
                    end-if;
               end-if;
          end-if;
     end-if;
     move "$marriageDate" to "parm/output/marriageDate";
     move "$divorceDate" to "parm/output/divorceDate";
     move "string($vWopId)" to "C1WriteOffProcessRead/writeOffProcess";
     invokeBS 'C1WriteOffProcessRead' using "C1WriteOffProcessRead";
     for ($debtAge in "C1WriteOffProcessRead/sa[serviceAgreement = $transferFromSa]/saArrears")
          move "$debtAge/daysAge" to $debtAgeD;
          //calculate ArrearsDate
          move null to "F1-DateMath";
          move "$PROCESS-DATE" to "F1-DateMath/beginDate";
          move 'F1AD' to "F1-DateMath/option";
          move "xs:integer($debtAgeD) * (-1)" to "F1-DateMath/days";
          move 'MECW01' to "F1-DateMath/calendar";
          invokeBS 'F1-DateMath' using "F1-DateMath";
          move "F1-DateMath/endDate" to $vArrearsDate;
          if ("xs:date($vArrearsDate) >= xs:date($marriageDate)")
               if ("xs:date($vArrearsDate) <= xs:date($divorceDate)")
                    move "xs:integer($count)" to $count;
               else
                    move "xs:integer($count) + 1" to $count;
               end-if;
          else
               move "xs:integer($count) + 1" to $count;
          end-if;
          if ("xs:integer($count) > 0")
               move 'true' to $partialDebtPresent;
               move "xs:integer(0)" to $count;
          end-if;
          move "$partialDebtPresent" to "parm/output/partialDebtPresent";
     end-for;
end-edit;
