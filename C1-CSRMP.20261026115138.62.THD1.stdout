          	// If no CS Request Account, skip further processing
          	if (isNull(csRequestAccount)) return;
          	// If parent CS Request is already in final state, transition to the next default status "Complete"
          	C1CSReqSSTC instance = createLibraryScript(C1CSReqSSTC.class);
          	if (!instance.isCSRequestNonFinal(csRequestAccount.getCustomerServiceRequest())) {
          		move true, "parm/hard/useDefaultNextStatus";
          		return;
