   // --  members from step 480 
     List<SQLResultRow> getWoStdSaList(String accountId, String woStdSaType) {
     
         String queryStr = null;
         String[] saTypes = null;
     
         String vWoStdSaType = woStdSaType;
     
         if (vWoStdSaType.contains(",")) {
     
             saTypes = vWoStdSaType.split(",");
     
             queryStr = "'";
     
             for (String saType : saTypes) {
                 queryStr = queryStr + saType.trim() + "','";
             }
     
             queryStr = queryStr.substring(0, queryStr.length() - 2);
     
         } else {
     
             queryStr = "'" + vWoStdSaType.trim() + "'";
         }
     
         StringBuilder builder = new StringBuilder();
     
         builder.append("SELECT SA.SA_ID ");
         builder.append("FROM CI_SA SA ");
         builder.append("WHERE SA.ACCT_ID = :accountId ");
         builder.append("AND SA.SA_TYPE_CD IN (" + queryStr + ") ");
         builder.append("AND SA.SA_STATUS_FLG = :stoppedSAStatus ");
     
         PreparedStatementQuery psQuery = createPreparedStatement(
             new StringBuffer(" ").append(builder.toString()).toString(),
             "isAccountHasWoStdSa"
         );
     
         psQuery.bindString(
             "accountId",
             accountId,
             "ACCT_ID"
         );
     
         psQuery.bindLookup(
             "stoppedSAStatus",
             ServiceAgreementStatusLookup.constants.STOPPED
         );
     
         List<SQLResultRow> queryResults = psQuery.list();
     
         psQuery.close();
     
         return queryResults;
     }
