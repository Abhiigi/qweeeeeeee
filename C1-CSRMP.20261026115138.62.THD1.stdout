                    createFrozenAdjustment(curServiceAgreement, new ServiceAgreement_Id(hasToTransferNewToSa).getEntity(), new AdjustmentType_Id(generalAdjType).getEntity(), adjAmountOfAll, getProcessDateTime().getDate(), Bool.FALSE)
     
                // }
     
                       }else {
                        //non-cuttable SA when debtClass != MSTD
