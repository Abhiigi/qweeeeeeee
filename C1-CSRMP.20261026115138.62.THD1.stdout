10:51:41,800 [DEFAULTWorker:5] INFO  (com.splwg.base.support.scripting.actions.Action) Executing script 'C1PROPREUPDT' : Executing step:  20: edit data
     move "parm/hard/businessObjectKey/customerServiceRequestId" to "C1GetChldCSR/input/customerServiceRequestId";
     move 'C1-CSREQPREM' to "C1GetChldCSR/input/mo";
     invokeSS 'C1GetChldCSR' using "C1GetChldCSR";
     if ("count(C1GetChldCSR/output/custSvcReqPremise) != 0")
          // Update BO, set childCanProceed to true
          move 'true' to "bo_schema/childCanProceed";
          invokeBO "parm/hard/businessObject/id" using "bo_schema" for fastUpdate;
          // Transition CS request Premise
          move "string(C1GetChldCSR/output/custSvcReqPremise[1]/custSvcReqPremiseId)" to $custSvcReqPremiseId;
          move 'C1-CSREQPREM' to "F1-AutoTransitionBO/mo";
          move "$custSvcReqPremiseId" to "F1-AutoTransitionBO/primeKeyValues/pkValue1";
          invokeBS 'F1-AutoTransitionBO' using "F1-AutoTransitionBO";
          if ("string(F1-AutoTransitionBO/finalStatus) = 'ERROR'")
               if ("string(bo_schema/csrErrorHandling) = 'C1ER'")
                    // Retrieve exception MO log
                    move "$custSvcReqPremiseId" to $custSvcReqPremiseId;
                    move '' to $seqNumber;
                    invokeGroovy 'retrieveLastCSRequestPremiseException';
                    // Read MO log
                    move 'C1-CSREQPREM' to "F1-ReadMOLog/mo";
                    move "$custSvcReqPremiseId" to "F1-ReadMOLog/pkValue1";
                    move "$seqNumber" to "F1-ReadMOLog/sequenceNumber";
                    invokeBS 'F1-ReadMOLog' using "F1-ReadMOLog";
                    // Parse exception message
                    move "F1-ReadMOLog/logMessage" to "C1-PrMOLogPr/input/messageText";
                    invokeSS 'C1-PrMOLogPr' using "C1-PrMOLogPr";
                    terminate with error (11131, 11606 %1="$custSvcReqPremiseId" %2="C1-PrMOLogPr/output/messageParm1" %3="C1-PrMOLogPr/output/messageParm2" %4="C1-PrMOLogPr/output/messageParm3" %5="C1-PrMOLogPr/output/messageParm4" %6="C1-PrMOLogPr/output/messageParm5" %7="C1-PrMOLogPr/output/messageParm6" %8="C1-PrMOLogPr/output/messageParm7" %9="C1-PrMOLogPr/output/messageParm8");
               end-if;
          end-if;
     end-if;
end-edit;
