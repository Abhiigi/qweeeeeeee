10:51:41,193 [DEFAULTWorker:5] INFO  (com.splwg.base.support.scripting.actions.Action) Executing script 'CMSETPAYARR' : Executing step:  35: edit data
     // Get the CSR Premise
     move "$BLANK" to $premiseId;
     invokeGroovy 'getPremise';
     // Get CSR Account Id
     move "$BLANK" to $accountId;
     invokeGroovy 'getAccount';
     // Get list of uncollectible SAs
     move "bo_schema/customElements/servicesToStart/cmSaList[isCollectible='N']" to $uncollectibleSAsList;
     move '0' to $index;
     move null to "CMAddToDo";
     for ($uncollectibleSA in "$uncollectibleSAsList")
          if ("xs:decimal($uncollectibleSA/saBalance) != xs:decimal(0.00)")
               // Get Acount's latest Agency Referral Id
               move "$BLANK" to $agencyAccountReferralId;
               move "$uncollectibleSA/accountId" to $agencyAccountId;
               invokeGroovy 'getLatestActiveAgencyReferral';
               if ("string($agencyAccountReferralId) = $BLANK")
                    goto nextRecord;
               end-if;
               move "xs:integer($index) + 1" to $index;
               // Store Account Id Characteristic
               move "$accountCharType" to "CMAddToDo/+toDoEntryCharacteristic/characteristicType";
               move "$uncollectibleSA/accountId" to "CMAddToDo/toDoEntryCharacteristic[last()]/characteristicValueForeignKey1";
               move "$uncollectibleSA/accountId" to "CMAddToDo/toDoEntryCharacteristic[last()]/searchCharacteristicValue";
               move "xs:integer($index) * xs:integer(10)" to "CMAddToDo/toDoEntryCharacteristic[last()]/sequence";
               // Store Agency Referral Characteristic
               move "$collAgyRefCharType" to "CMAddToDo/+toDoEntryCharacteristic/characteristicType";
               move "$agencyAccountReferralId" to "CMAddToDo/toDoEntryCharacteristic[last()]/characteristicValueForeignKey1";
               move "$agencyAccountReferralId" to "CMAddToDo/toDoEntryCharacteristic[last()]/searchCharacteristicValue";
               move "xs:integer($index) * xs:integer(10)" to "CMAddToDo/toDoEntryCharacteristic[last()]/sequence";
          end-if;
          nextRecord: move "$BLANK" to $agencyAccountReferralId;
     end-for;
     if ("count(CMAddToDo/toDoEntryCharacteristic) > 0")
          move "$uncollDebtExistsToDoType" to "CMAddToDo/toDoType";
          if ("string($uncollDebtExistsToDoRole) != $BLANK")
               move "$uncollDebtExistsToDoRole" to "CMAddToDo/toDoRole";
          end-if;
          move "$uncollDebtExistsToDoRole" to "CMAddToDo/toDoRole";
          move '90003' to "CMAddToDo/messageCategory";
          move '27702' to "CMAddToDo/messageNumber";
          move '1' to "CMAddToDo/+toDoMessageParameter/sequence";
          move "$accountId" to "CMAddToDo/toDoMessageParameter[last()]/messageParameterValue";
          move "$CURRENT-DTTM" to "CMAddToDo/creationDateTime";
          move "$accountId" to "CMAddToDo/toDoDrillKeyValue[last()]/keyValue";
          move "$accountId" to "CMAddToDo/toDoSortKeyValue[last()]/keyValue";
          invokeSS 'CMAddToDo' using "CMAddToDo";
     end-if;
end-edit;
