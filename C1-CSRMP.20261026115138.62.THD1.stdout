   // --  members from step 320 
     Void comboCheck(){
      String accountId = evalString('$transferFromAccount');
           PreparedStatementQuery psQuery = createPreparedStatement(
             """
                    select distinct SAT.SVC_TYPE_CD from CI_SA SA, CI_SA_TYPE SAT
           where SA.SA_TYPE_CD = SAT.SA_TYPE_CD AND
     SA.CIS_DIVISION = SAT.CIS_DIVISION
     AND SAT.SVC_TYPE_CD IN ('E','G')
      and sa.acct_id = :accountId
      and SA.SA_STATUS_FLG in ('40','60')
      and SA.SA_ID
           IN (SELECT SA_ID FROM CI_WO_PROC_SA wsa WHERE
     wsa.WO_SA_STAT_FLG = '10'
              and wsa.SA_ID = sa.SA_ID)
           """, 'Select Statement')
     
           psQuery.bindString("accountId", accountId,"ACCT_ID");
     
           List<SQLResultRow> queryResults = psQuery.list();
     
           psQuery.close();
     
           if(queryResults.size() > 1) {
             setStringScriptVariable("comboChecking", "true")
           }
       	  else {
           setStringScriptVariable("comboChecking", "false")
           }
       logger.debug("log8 comboChecking"+evalString('$comboChecking'));
         }
