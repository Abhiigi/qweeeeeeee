package c1; 

import com.splwg.base.api.SoftParameter
import com.splwg.ccb.api.lookup.NotificationEventTypeLookup
import com.splwg.ccb.domain.customerServiceRequestManagement.customerServiceRequest.entity.CustomerServiceRequest
import com.splwg.base.domain.serviceTask.ServiceTask
import com.splwg.base.api.sql.PreparedStatementQuery
import com.splwg.base.api.sql.SQLResultRow
import com.splwg.ccb.domain.customerinfo.account.entity.Account
import com.splwg.base.api.serviceScript.ServiceScriptInstance
import com.splwg.base.api.businessObject.COTSInstanceNode
import com.splwg.base.api.businessObject.BusinessObjectInstance
import com.splwg.base.api.businessObject.BusinessObjectDispatcher
import com.splwg.base.api.serviceScript.ServiceScriptDispatcher
//Generated source for script:C1SSBLDWCNTF-1
@groovy.transform.CompileStatic
 class C1SSBLDWCNTF extends com.splwg.base.domain.common.businessObject.BusinessObjectEnterStatusAlgorithmSpot_GroovyImpl 
implements com.splwg.base.domain.common.businessObject.BusinessObjectEnterStatusAlgorithmSpot
 {
    private static final com.splwg.shared.logging.Logger logger = com.splwg.shared.logging.LoggerFactory.getLogger("ugbu.groovy.C1SSBLDWCNTF") 
    // --  members from step 20 
     @SoftParameter(sequence=10, required=true) NotificationEventTypeLookup notificationEventType;
   // --  end members from step 20 


   // --  members from step 30 
     public void invoke() {
     	CustomerServiceRequest customerServiceRequest = businessObjectKey.getEntity(CustomerServiceRequest.class);
     	if (isNull(customerServiceRequest)) return;
     	ServiceTask serviceTask = retrieveServiceTaskLinkedToCSRequest(customerServiceRequest);
     	if (isNull(serviceTask)) return;
     	buildNotification(customerServiceRequest, serviceTask);
     }
     
     ServiceTask retrieveServiceTaskLinkedToCSRequest(CustomerServiceRequest customerServiceRequest) {
     	PreparedStatementQuery query = createPreparedStatement("""
     	SELECT
     		STASK.F1_SVC_TASK_ID AS F1_SVC_TASK_ID
     	FROM
     		F1_SVC_TASK STASK,
     		F1_BUS_OBJ BO,
     		F1_SVC_TASK_REL_OBJ STASK_OBJ,
     		F1_BUS_OBJ_OPT BOOPT
     	WHERE STASK.BUS_OBJ_CD = BOOPT.BUS_OBJ_CD
     		AND BOOPT.BUS_OBJ_OPT_VAL = 'C1SS'
     		AND BOOPT.BUS_OBJ_OPT_FLG = 'C1SF'
     		AND STASK.BUS_OBJ_CD = BO.BUS_OBJ_CD
     		AND STASK.F1_SVC_TASK_ID = STASK_OBJ.F1_SVC_TASK_ID
     		AND STASK_OBJ.MAINT_OBJ_CD = 'C1-CSREQ'
     		AND STASK_OBJ.PK_VALUE1 = :csRequestId
     
     	""", 'Retrieve SVC Task');
     
     	query.bindEntity("csRequestId", customerServiceRequest);
     
     	// Assumption is that there will only one Service Task linked to the CS Request
     	SQLResultRow row = query.firstRow();
     	if (isNull(row)) return null;
     	return row.getEntity("F1_SVC_TASK_ID", ServiceTask.class);
     }
     
     void buildNotification(CustomerServiceRequest customerServiceRequest, ServiceTask serviceTask) {
     	BusinessObjectInstance boInstance = BusinessObjectInstance.create(serviceTask.getBusinessObject());
     	boInstance.set("serviceTaskId", serviceTask.getId().getTrimmedValue());
     	boInstance = BusinessObjectDispatcher.read(boInstance);
     
     	COTSInstanceNode startStopDetailsGroup = boInstance.getGroup("startStopDetails");
     	Account account = startStopDetailsGroup.getEntity("accountId", Account.class);
     
     	ServiceScriptInstance ssInstance = ServiceScriptInstance.create("C1SSSSTTBNtf");
     	COTSInstanceNode inputGroup = ssInstance.getGroup("input");
     	inputGroup.set("serviceTaskId", serviceTask);
     	inputGroup.set("bo", serviceTask.getBusinessObject());
     	inputGroup.set("notificationEventType", notificationEventType);
     	if (!isNull(account)) {
     		inputGroup.set("accountId", account);
         }
     	inputGroup.set("customerServiceRequestId", customerServiceRequest);
     	ServiceScriptDispatcher.invoke(ssInstance);
     }
   // --  end members from step 30 



}
